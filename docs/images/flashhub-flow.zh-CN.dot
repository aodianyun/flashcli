digraph FlashHubFlow {
  graph [rankdir=LR, bgcolor="#f7f9fc", pad=0.35, nodesep=0.5, ranksep=0.75,
         fontname="Noto Sans CJK SC", fontsize=24, labelloc="t",
         label=<<B>FlashHub 与消费端流程</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">发布 → 目录/版本 → CLI / flashserver / desktop 同步</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.18,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  subgraph cluster_pub {
    label=<<B>Publishers / 发布者</B>>; fontsize=14; color="#fed7aa"; style="rounded,filled"; fillcolor="#fffaf5";
    bauthor [fillcolor="#ffedd5", color="#f97316", label=<<B>Bundle author</B><BR/><FONT POINT-SIZE="10">build · validate<BR/>release_bundle.sh</FONT>>];
    aauthor [fillcolor="#ffedd5", color="#f97316", label=<<B>App author</B><BR/><FONT POINT-SIZE="10">app manifest<BR/>install / setup scripts</FONT>>];
  }

  subgraph cluster_hub {
    label=<<B>FlashHub</B>>; fontsize=14; color="#fecaca"; style="rounded,filled"; fillcolor="#fff7f7";
    api [fillcolor="#fee2e2", color="#ef4444", label=<<B>Catalog / API</B><BR/><FONT POINT-SIZE="10">search · tags<BR/>app list · versions</FONT>>];
    repo [fillcolor="#fee2e2", color="#ef4444", label=<<B>Bundle repo</B><BR/><FONT POINT-SIZE="10">manifest · files<BR/>runtime dirs · weights metadata</FONT>>];
    apps [fillcolor="#fee2e2", color="#ef4444", label=<<B>App registry</B><BR/><FONT POINT-SIZE="10">app manifest<BR/>default bundles · scripts</FONT>>];
  }

  subgraph cluster_use {
    label=<<B>Consumers / 消费端</B>>; fontsize=14; color="#bbf7d0"; style="rounded,filled"; fillcolor="#f7fff9";
    cli [fillcolor="#dcfce7", color="#22c55e", label=<<B>flashcli</B><BR/><FONT POINT-SIZE="10">pull · run · serve<BR/>local cache · offline</FONT>>];
    srv [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>flashserver</B><BR/><FONT POINT-SIZE="10">/api/v1/catalog proxy<BR/>preload · app install</FONT>>];
    desktop [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Desktop</B><BR/><FONT POINT-SIZE="10">FlashHub page<BR/>apps / models</FONT>>];
    cache [shape=cylinder, fillcolor="#fef9c3", color="#eab308", label=<<B>本地缓存</B><BR/><FONT POINT-SIZE="10">bundles · weights<BR/>runtimes</FONT>>];
  }

  bauthor -> repo [label="publish bundle", color="#f97316"];
  aauthor -> apps [label="publish app", color="#f97316"];
  repo -> api [label="index", style=dashed, color="#ef4444"];
  apps -> api [label="index", style=dashed, color="#ef4444"];
  api -> cli [label="search / resolve", color="#f97316"];
  cli -> repo [label="sync manifest/files/runtime", color="#f97316"];
  api -> srv [label="catalog / app proxy", color="#f97316"];
  srv -> repo [label="preload / app prepare", style=dashed, color="#f97316"];
  desktop -> srv [label="HTTP", color="#60a5fa"];
  cli -> cache [label="materialize", color="#eab308"];
  srv -> cache [label="preload/unload", color="#eab308"];
}
