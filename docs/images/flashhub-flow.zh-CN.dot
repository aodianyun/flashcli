digraph flashhub_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>FlashHub bundle 与权重获取 / 缓存流程</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">发布 → repo index → bundle 树 → venv / 权重 → 本地缓存；离线优先</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  build [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=13.5, label=<<B>bundles/&lt;name&gt;/build.sh</B><BR/><FONT POINT-SIZE="10.5">编译 FlashRT，组装 runtime cell</FONT><BR/><FONT POINT-SIZE="10.5">当前环境或 Docker 矩阵</FONT>>];
  pack [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>scripts/pack_bundle.sh</B><BR/><FONT POINT-SIZE="10.5">只复制 RELEASE_PACK_FILES</FONT><BR/><FONT POINT-SIZE="10.5">选择 runtime cell；重写 dist/flashcli-bundle.json</FONT><BR/><FONT POINT-SIZE="10.5">写 build 来源；不打包权重</FONT>>];
  validate [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>flashcli bundle validate</B><BR/><FONT POINT-SIZE="10.5">协议 / entry / capabilities / resources</FONT><BR/><FONT POINT-SIZE="10.5">runtime cell + .so ABI 探测</FONT><BR/><FONT POINT-SIZE="10.5">校验源目录，不是 dist</FONT>>];
  upload [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=13.5, label=<<B>人工上传 dist/</B><BR/><FONT POINT-SIZE="10.5">仓库内没有上传客户端</FONT><BR/><FONT POINT-SIZE="10.5">保留相对路径；版本即 ref</FONT>>];
  repo [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>FlashHub repo index</B><BR/><FONT POINT-SIZE="10.5">GET /api/v1/repos/{ns}/{name}:{ver}</FONT><BR/><FONT POINT-SIZE="10.5">files[] + download_url + md5</FONT>>];
  entry [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>flashcli pull / run / serve</B><BR/><FONT POINT-SIZE="10.5">pull：verifyRemote=true，强制远端校验</FONT><BR/><FONT POINT-SIZE="10.5">run/serve：本地优先，不调用 host.Pull</FONT>>];
  ensure [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>host.EnsureBundle</B><BR/><FONT POINT-SIZE="10.5">本地路径直接使用</FONT><BR/><FONT POINT-SIZE="10.5">FlashHub：标记或 index → manifest → SyncBundle</FONT><BR/><FONT POINT-SIZE="10.5">只取选中的 runtime cell + 公共文件</FONT>>];
  marker [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>bundle 标记存在？</B><BR/><FONT POINT-SIZE="10.5">bundles/&lt;name&gt;/&lt;ver&gt;/.flashcli_bundle.json</FONT>>];
  reuse [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>复用 bundle 树（离线）</B><BR/><FONT POINT-SIZE="10.5">不校验文件、不访问网络</FONT>>];
  sync [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DownloadManifest + SyncBundle</B><BR/><FONT POINT-SIZE="10.5">repo index → manifest</FONT><BR/><FONT POINT-SIZE="10.5">MD5 校验；写 runtime / bundle 标记</FONT>>];
  runtime [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", fontsize=12.5, label=<<B>host.EnsureRuntime / venv.Ensure</B><BR/><FONT POINT-SIZE="10.5">PreflightBundle：env key / .so / host ABI</FONT><BR/><FONT POINT-SIZE="10.5">uv · flashcli-bundle[infer] · python_dependencies</FONT><BR/><FONT POINT-SIZE="10.5">fingerprint 命中即离线复用</FONT>>];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>weights.PrepareBundle</B><BR/><FONT POINT-SIZE="10.5">models/store/&lt;source&gt;/&lt;repo&gt;@&lt;rev&gt;-&lt;hash&gt;</FONT><BR/><FONT POINT-SIZE="10.5">host 完整性：.flashcli_download.json + .incomplete</FONT><BR/><FONT POINT-SIZE="10.5">bundle 就绪：allow / require / norm stats</FONT><BR/><FONT POINT-SIZE="10.5">extra_weights / extra_pull / post_pull</FONT>>];
  cache [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>本地缓存</B><BR/><FONT POINT-SIZE="10.5">bundles/&lt;name&gt;/&lt;version&gt;</FONT><BR/><FONT POINT-SIZE="10.5">models/store/&lt;source&gt;/&lt;repo&gt;@&lt;rev&gt;-&lt;hash&gt;</FONT><BR/><FONT POINT-SIZE="10.5">runtimes/&lt;runtime_id&gt;/venv</FONT>>];
  offline [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>离线与就绪</B><BR/><FONT POINT-SIZE="10.5">bundle 标记 + 权重完整 + fingerprint 命中 → 不联网</FONT><BR/><FONT POINT-SIZE="10.5">present-but-incomplete 永不接受；legacy 就绪可接受</FONT><BR/><FONT POINT-SIZE="10.5">catalog / app registry / desktop 走 /api/v1，不直连 FlashHub</FONT>>];
  build -> pack [color="#EA580C", style="solid"];
  pack -> validate [color="#D97706", style="solid"];
  validate -> upload [color="#DC2626", style="solid", label="通过"];
  upload -> repo [color="#DC2626", style="solid", label="发布版本"];
  repo -> entry [color="#EA580C", style="solid", label="index + files"];
  entry -> ensure [color="#64748B", style="solid"];
  ensure -> marker [color="#64748B", style="solid"];
  marker -> reuse [color="#16A34A", style="solid", label="是"];
  marker -> sync [color="#EA580C", style="solid", label="否"];
  sync -> runtime [color="#EA580C", style="solid"];
  reuse -> runtime [color="#16A34A", style="dashed"];
  runtime -> weights [color="#DB2777", style="solid"];
  weights -> cache [color="#D97706", style="solid"];
  cache -> offline [color="#64748B", style="dotted"];
}
