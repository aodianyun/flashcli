digraph go_module_map {
  graph [rankdir=LR, bgcolor="#F7F9FC", pad=0.4, nodesep=0.4, ranksep=0.45, fontname="Noto Sans CJK SC", fontsize=30, labelloc=t, label=<<B>Go host 模块地图</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">cmd → 前端 → 共享 host 服务 → 执行后端；共享逻辑只实现一次</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, margin="0.46,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=11, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  subgraph cluster_1 {
    label=<<B>入口</B>>;
    style="rounded,filled"; color="#3B82F6"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  cmd_cli [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=2.00, label="cmd/flashcli\npull / run / serve\nbundle / models / app"];
  cmd_srv [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=2.24, label="cmd/flashserver\ngateway + scheduler\nmanagement API + console"];
  cmd_setup [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=2.00, label="cmd/flashserver-setup\nLinux / WSL 安装"];
  }
  subgraph cluster_2 {
    label=<<B>前端</B>>;
    style="rounded,filled"; color="#8B5CF6"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  cli [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=2.24, label="internal/cli\nflags / prompts / tables\n编排 host 服务"];
  server [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=2.64, label="internal/server\nHTTP / auth / jobs / ws\ngateway / scheduler / manager\npreload / apps / catalog"];
  setup [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=2.24, label="internal/setup\nsystemd / WSL / 服务注册"];
  }
  subgraph cluster_3 {
    label=<<B>共享 host 服务（CLI 与 flashserver 必须一致）</B>>;
    style="rounded,filled"; color="#22C55E"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  host [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.28, label="internal/host\ncache discovery / readiness\npull / EnsureRuntime / ResolveWeights\ncleanup / storage"];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=13, width=3.12, label="internal/weights\nstore key / download manifest\nresume / allow/require / norm stats"];
  runtime [shape=box, style="rounded,filled", fillcolor="#CCFBF1", color="#14B8A6", penwidth=1.3, fontsize=13, width=2.64, label="internal/runtime\nruntime IDs / markers / paths"];
  venv [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", penwidth=1.3, fontsize=13, width=2.64, label="internal/venv\nuv / pip / python deps\nfingerprint / protocol schema"];
  manifest [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.3, fontsize=13, width=2.88, label="internal/manifest\nv3/v4 parse / validate\nentry / capabilities / resources"];
  apps [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=13, width=2.48, label="internal/apps\napp install / setup / state"];
  modelrun [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=2.96, label="internal/modelrun\nserve launch / logs / WaitHealthy"];
  gpu [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", penwidth=1.3, fontsize=13, width=2.96, label="internal/gpu · preflight · cuda\nGPU / SM / CUDA probes\nhost ABI / system requirements"];
  ref [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=13, width=2.80, label="internal/ref · flashhub\nref parse / cache key\nFlashHub index / catalog / apps"];
  }
  subgraph cluster_4 {
    label=<<B>执行后端</B>>;
    style="rounded,filled"; color="#38BDF8"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  inferexec [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=2.80, label="internal/inferexec\nreexec bundle venv\npython -m flashcli_bundle.infer"];
  nativeexec [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=1.84, label="internal/nativeexec\nnative-exec process\nNDJSON / HTTP"];
  nativeabi [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=2.64, label="internal/nativeabi · hostabi\nABI / .so / sessions\nhost glibc / GLIBCXX checks"];
  }
  subgraph cluster_5 {
    label=<<B>边界与机械门禁</B>>;
    style="rounded,filled"; color="#EF4444"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  protocol [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.3, fontsize=13, width=1.84, label="flashcli-bundle\ndependencies = []\nprotocol + infer 包"];
  guard [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.3, fontsize=13, width=3.28, label="go/internal/architecture tests\n禁止重复 nvidia-smi / walker / log 名\n禁止在 go/ 写模型专属逻辑"];
  }
  cmd_cli -> cli [color="#64748B", style="solid"];
  cmd_srv -> server [color="#64748B", style="solid"];
  cmd_setup -> setup [color="#64748B", style="solid"];
  cli -> host [color="#16A34A", style="solid", label="pull / run / serve"];
  server -> host [color="#16A34A", style="solid", label="preload / catalog"];
  server -> modelrun [color="#0284C7", style="solid", label="resident"];
  server -> apps [color="#EA580C", style="solid", label="apps"];
  host -> weights [color="#D97706", style="solid"];
  host -> runtime [color="#0D9488", style="solid"];
  host -> venv [color="#DB2777", style="solid"];
  host -> manifest [color="#DC2626", style="solid"];
  host -> ref [color="#EA580C", style="solid"];
  server -> gpu [color="#64748B", style="solid"];
  cli -> gpu [color="#64748B", style="dashed"];
  cli -> apps [color="#EA580C", style="dashed", label="app"];
  apps -> host [color="#16A34A", style="dashed", label="Pull"];
  venv -> inferexec [color="#0284C7", style="solid", label="python"];
  modelrun -> inferexec [color="#0284C7", style="solid", label="serve"];
  manifest -> nativeexec [color="#0284C7", style="solid", label="native-exec"];
  manifest -> nativeabi [color="#0284C7", style="solid", label="native-abi"];
  venv -> protocol [color="#DC2626", style="dashed", label="安装"];
  guard -> protocol [color="#DC2626", style="dotted", label="检查"];
  guard -> host [color="#DC2626", style="dotted", label="检查"];
}
