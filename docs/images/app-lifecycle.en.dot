digraph app_lifecycle {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>Application install and setup flow</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">install → prepare → setup → ready; apps call /v1 and never own model start/stop</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  install [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>POST /api/v1/apps/{org}/{name}/install</B><BR/><FONT POINT-SIZE="10.5">body: version · bundles · install_command</FONT><BR/><FONT POINT-SIZE="10.5">client_os / client_arch / force</FONT>>];
  fetch [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>FetchAppManifest + Validate + Platform</B><BR/><FONT POINT-SIZE="10.5">FlashHub app manifest</FONT><BR/><FONT POINT-SIZE="10.5">platform command · default bundles · pinned version</FONT>>];
  already [shape=diamond, style="filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12, label=<<B>prepared / ready and force=false?</B>>];
  noop [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=13.5, label=<<B>AlreadyReady (no-op)</B>>];
  planned [shape=box, style="rounded,filled", fillcolor="#E0E7FF", color="#6366F1", fontsize=12.5, label=<<B>planned</B><BR/><FONT POINT-SIZE="10.5">written to apps.json before the install command</FONT><BR/><FONT POINT-SIZE="10.5">cross-process lock + atomic write</FONT>>];
  cmd [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>install.command</B><BR/><FONT POINT-SIZE="10.5">run: daemon executes the shell command</FONT><BR/><FONT POINT-SIZE="10.5">client: desktop runs it; daemon only records</FONT><BR/><FONT POINT-SIZE="10.5">URL: show the download page; skip: do not execute</FONT>>];
  failed [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=13.5, label=<<B>failed</B><BR/><FONT POINT-SIZE="10.5">install / prepare failed; logs kept</FONT><BR/><FONT POINT-SIZE="10.5">cached bundles kept; retry = POST install again</FONT>>];
  models [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>Prepare default models?</B>>];
  preparing [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>preparing</B><BR/><FONT POINT-SIZE="10.5">serially host.Pull the default bundles</FONT><BR/><FONT POINT-SIZE="10.5">all Prepared=true</FONT>>];
  prepared [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>prepared</B><BR/><FONT POINT-SIZE="10.5">Connection = {base_url, api_key=local, models, model_refs}</FONT>>];
  setup [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>POST /api/v1/apps/{org}/{name}/setup</B><BR/><FONT POINT-SIZE="10.5">set state=ready, then run setup scripts</FONT><BR/><FONT POINT-SIZE="10.5">scripts: saved plan / SHA-256 verify / ordered run</FONT><BR/><FONT POINT-SIZE="10.5">script failure writes setup_error; state stays ready</FONT>>];
  ready [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=13.5, label=<<B>ready</B><BR/><FONT POINT-SIZE="10.5">Connection in apps.json; APIKey is always local</FONT><BR/><FONT POINT-SIZE="10.5">inference via /v1 → gateway → scheduler</FONT>>];
  uninstall [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DELETE /api/v1/apps/{org}/{name}</B><BR/><FONT POINT-SIZE="10.5">by default removes the registry entry only</FONT><BR/><FONT POINT-SIZE="10.5">?purge_models=1 also calls RemoveCachedRef</FONT><BR/><FONT POINT-SIZE="10.5">shared assets kept; never stops a resident</FONT>>];
  uninstalled [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=13.5, label=<<B>uninstalled</B><BR/><FONT POINT-SIZE="10.5">model cache / logs / setup-cache kept by default</FONT>>];
  note [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>Desktop and prepare</B><BR/><FONT POINT-SIZE="10.5">client commands / installers run locally, then POST install</FONT><BR/><FONT POINT-SIZE="10.5">POST .../prepare: NoInstall + PrepareOnly + Force</FONT><BR/><FONT POINT-SIZE="10.5">apps have no PID / child endpoint and cannot start/stop models</FONT>>];
  install -> fetch [color="#64748B", style="solid"];
  fetch -> already [color="#64748B", style="solid"];
  already -> noop [color="#64748B", style="solid", label="yes"];
  already -> planned [color="#4F46E5", style="solid", label="no"];
  planned -> cmd [color="#64748B", style="solid"];
  cmd -> failed [color="#DC2626", style="dashed", label="fail"];
  cmd -> models [color="#16A34A", style="solid", label="ok"];
  models -> preparing [color="#D97706", style="solid", label="yes"];
  models -> prepared [color="#16A34A", style="dashed", label="no"];
  preparing -> prepared [color="#16A34A", style="solid", label="all done"];
  preparing -> failed [color="#DC2626", style="dashed", label="fail"];
  prepared -> setup [color="#7C3AED", style="solid", label="configure"];
  setup -> ready [color="#16A34A", style="solid", label="done / script failure both ready"];
  ready -> uninstall [color="#EA580C", style="solid", label="uninstall"];
  uninstall -> uninstalled [color="#64748B", style="solid"];
  ready -> setup [color="#7C3AED", style="dashed", label="reconfigure"];
  prepared -> note [color="#64748B", style="dotted"];
}
