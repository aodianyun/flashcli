digraph AppLifecycle {
  graph [rankdir=LR, bgcolor="#f7f9fc", pad=0.35, nodesep=0.45, ranksep=0.7,
         fontname="Noto Sans CJK SC", fontsize=24, labelloc="t",
         label=<<B>flashserver 应用生命周期</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">install → prepare → setup → ready；模型始终由调度器按需启动</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.18,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  planned [fillcolor="#e0e7ff", color="#818cf8", label=<<B>PLANNED</B><BR/><FONT POINT-SIZE="10">manifest 合法<BR/>平台支持</FONT>>];
  install [fillcolor="#ffedd5", color="#f97316", label=<<B>INSTALL</B><BR/><FONT POINT-SIZE="10">客户端脚本 / 安装包<BR/>或 skip（仅准备模型）</FONT>>];
  prepared [fillcolor="#fef9c3", color="#eab308", label=<<B>PREPARED</B><BR/><FONT POINT-SIZE="10">default bundles<BR/>磁盘就绪（preload）</FONT>>];
  setup [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>SETUP</B><BR/><FONT POINT-SIZE="10">写入网关连接<BR/>执行确认过的 setup scripts</FONT>>];
  ready [fillcolor="#dcfce7", color="#22c55e", label=<<B>READY</B><BR/><FONT POINT-SIZE="10">应用已配置<BR/>推理走 /v1</FONT>>];
  failed [fillcolor="#fee2e2", color="#ef4444", label=<<B>FAILED</B><BR/><FONT POINT-SIZE="10">安装/准备失败<BR/>保留日志</FONT>>];
  gateway [fillcolor="#e0f2fe", color="#0284c7", label=<<B>Gateway /v1</B><BR/><FONT POINT-SIZE="10">scheduler 按需启动 resident<BR/>应用不持有 PID / endpoint</FONT>>];

  planned -> install [label="install"];
  install -> prepared [label="脚本/安装包完成"];
  install -> failed [label="失败", color="#ef4444"];
  planned -> prepared [label="skip / no model", style=dashed];
  prepared -> setup [label="显式配置"];
  setup -> ready [label="setup ok"];
  setup -> ready [label="脚本失败仍 READY", style=dashed, color="#f59e0b"];
  ready -> gateway [label="请求推理", color="#0284c7"];
  ready -> planned [label="卸载 / 重新安装", style=dashed, color="#94a3b8"];
  failed -> install [label="重试", style=dashed, color="#94a3b8"];
}
