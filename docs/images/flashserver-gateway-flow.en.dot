digraph flashserver_gateway_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>flashserver gateway and model scheduling flow</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">/v1 request → route / model selection → disk and capability gates → schedule → proxy / release</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  client [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>Client /v1 request</B><BR/><FONT POINT-SIZE="10.5">OpenAI / Anthropic SDK / App / Desktop</FONT><BR/><FONT POINT-SIZE="10.5">inference never touches a child endpoint</FONT>>];
  auth [shape=diamond, style="filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12, label=<<B>token configured?</B><BR/><FONT POINT-SIZE="10.5">Bearer / X-Flashcli-Token</FONT><BR/><FONT POINT-SIZE="10.5">failure → 401</FONT>>];
  route [shape=diamond, style="filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12, label=<<B>Route owner?</B><BR/><FONT POINT-SIZE="10.5">host standard / bundle custom / reserved</FONT><BR/><FONT POINT-SIZE="10.5">unknown reserved path → 405/404</FONT>>];
  model [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>Select model (resolveGatewayModel)</B><BR/><FONT POINT-SIZE="10.5">JSON body / multipart form / ?model=</FONT><BR/><FONT POINT-SIZE="10.5">must be a full ref; body/query conflict → 400</FONT>>];
  assets [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>Assets ready / preloadReady?</B><BR/><FONT POINT-SIZE="10.5">bundle + weights + runtime</FONT><BR/><FONT POINT-SIZE="10.5">missing with auto_pull=false → 404</FONT>>];
  preload [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>ensurePreload</B><BR/><FONT POINT-SIZE="10.5">start a host.Pull job</FONT><BR/><FONT POINT-SIZE="10.5">return 503 + Retry-After / job id</FONT>>];
  capability [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>capability declared?</B><BR/><FONT POINT-SIZE="10.5">standard routes only; custom skips</FONT><BR/><FONT POINT-SIZE="10.5">undeclared → 400 unsupported</FONT>>];
  acquire [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Scheduler.Acquire(ref)</B><BR/><FONT POINT-SIZE="10.5">wait for resident start / queue</FONT><BR/><FONT POINT-SIZE="10.5">default resident_start_wait 10s + queue 30s</FONT>>];
  placement [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>planLocked + placementFor</B><BR/><FONT POINT-SIZE="10.5">max_loaded=0 means no slot limit</FONT><BR/><FONT POINT-SIZE="10.5">runtime cell: SM + CUDA + Python ABI</FONT><BR/><FONT POINT-SIZE="10.5">free VRAM/GPU ≥ min_vram + headroom; gpu_count</FONT><BR/><FONT POINT-SIZE="10.5">no GPU cell → CPU fallback (can be disabled)</FONT><BR/><FONT POINT-SIZE="10.5">slots/VRAM short → LRU evict idle or queue</FONT>>];
  queue [shape=note, style="filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=10.5, label=<<B>Queue / no placement</B><BR/><FONT POINT-SIZE="10.5">QueueMax default 16; queue_full → 429</FONT><BR/><FONT POINT-SIZE="10.5">no_compatible_runtime fails immediately</FONT>>];
  start [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Start or reuse resident</B><BR/><FONT POINT-SIZE="10.5">Manager.LoadScheduled → flashcli serve child</FONT><BR/><FONT POINT-SIZE="10.5">WaitHealthy ≤120s; failure → resident_start_failed</FONT>>];
  lease [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Lease + Manager.Endpoint(ref)</B><BR/><FONT POINT-SIZE="10.5">active_requests++; blocks eviction / idle stop</FONT><BR/><FONT POINT-SIZE="10.5">exact full-ref endpoint match</FONT>>];
  proxy [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>proxyGateway</B><BR/><FONT POINT-SIZE="10.5">method / path / query / body unchanged</FONT><BR/><FONT POINT-SIZE="10.5">strips auth / token / cookie; client close → cancel</FONT><BR/><FONT POINT-SIZE="10.5">rewrite SSE data lines; JSON ≤32MiB model</FONT>>];
  release [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>lease.Release</B><BR/><FONT POINT-SIZE="10.5">leases--; busy → ready; last_used=now</FONT><BR/><FONT POINT-SIZE="10.5">idle reaper / reconcile dead children</FONT>>];
  errors [shape=note, style="filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=10.5, label=<<B>Error mapping</B><BR/><FONT POINT-SIZE="10.5">400 conflict / required / invalid / unsupported</FONT><BR/><FONT POINT-SIZE="10.5">404 not_found / not_servable; 405 reserved</FONT><BR/><FONT POINT-SIZE="10.5">429 queue_full; 503 preparing / no_placement / starting</FONT><BR/><FONT POINT-SIZE="10.5">499 client_closed; 502 proxy / start_failed</FONT>>];
  mgmt [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>Control plane is not the inference path</B><BR/><FONT POINT-SIZE="10.5">/api/v1/models/preload: disk only</FONT><BR/><FONT POINT-SIZE="10.5">/api/v1/models/unload: stop + remove cache</FONT>>];
  client -> auth [color="#64748B", style="solid"];
  auth -> route [color="#16A34A", style="solid", label="yes / unset"];
  route -> model [color="#2563EB", style="solid", label="standard / custom"];
  model -> assets [color="#64748B", style="solid"];
  assets -> preload [color="#EA580C", style="solid", label="no + auto_pull"];
  assets -> capability [color="#16A34A", style="solid", label="yes"];
  capability -> acquire [color="#16A34A", style="solid", label="yes / custom"];
  acquire -> placement [color="#64748B", style="solid"];
  placement -> start [color="#16A34A", style="solid", label="placed"];
  placement -> queue [color="#DC2626", style="dashed", label="resource short"];
  start -> lease [color="#16A34A", style="solid", label="ready"];
  lease -> proxy [color="#64748B", style="solid"];
  proxy -> release [color="#16A34A", style="solid", label="done / closed"];
  release -> mgmt [color="#64748B", style="dotted"];
  release -> errors [color="#64748B", style="invis"];
}
