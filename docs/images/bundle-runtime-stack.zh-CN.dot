digraph BundleRuntimeStack {
  graph [rankdir=TB, bgcolor="#f7f9fc", pad=0.35, nodesep=0.5, ranksep=0.55,
         fontname="Noto Sans CJK SC", fontsize=24, labelloc="t",
         label=<<B>Model Bundle 与 FlashRT 运行时栈</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">FlashHub 发布 → host 准备 → bundle venv / 原生入口 → FlashRT</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.18,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  subgraph cluster_hub {
    label=<<B>FlashHub / 远端</B>>; fontsize=14; color="#fed7aa"; style="rounded,filled"; fillcolor="#fffaf5";
    catalog [fillcolor="#ffedd5", color="#f97316", label=<<B>Catalog / Apps</B><BR/><FONT POINT-SIZE="10">bundle 搜索 · 版本 · 应用 manifest</FONT>>];
    repo [fillcolor="#ffedd5", color="#f97316", label=<<B>Bundle repo</B><BR/><FONT POINT-SIZE="10">flashcli-bundle.json<BR/>entry · runtime dirs · weights metadata</FONT>>];
  }

  subgraph cluster_bundle {
    label=<<B>Model Bundle / 版本化契约</B>>; fontsize=14; color="#fecaca"; style="rounded,filled"; fillcolor="#fff7f7";
    manifest [fillcolor="#fee2e2", color="#ef4444", label=<<B>flashcli-bundle.json</B><BR/><FONT POINT-SIZE="10">format_version · protocol_version<BR/>defaults + environments<BR/>resources: min_vram_mib · gpu_count · min_ram_mib<BR/>run_options · serve_options</FONT>>];
    entry [fillcolor="#fee2e2", color="#ef4444", label=<<B>entry / 入口</B><BR/><FONT POINT-SIZE="10">kind: python · native-exec · native-abi<BR/>run / serve<BR/>capabilities · concurrency</FONT>>];
    cells [fillcolor="#fee2e2", color="#ef4444", label=<<B>Runtime cells</B><BR/><FONT POINT-SIZE="10">sm89-cu124-linux-x86_64-py312<BR/>runtime dir · python_abi<BR/>CUDA / SM 兼容性</FONT>>];
  }

  subgraph cluster_host {
    label=<<B>Host / flashcli 准备</B>>; fontsize=14; color="#bbf7d0"; style="rounded,filled"; fillcolor="#f7fff9";
    venv [fillcolor="#dcfce7", color="#22c55e", label=<<B>Bundle venv</B><BR/><FONT POINT-SIZE="10">uv / pip<BR/>flashcli-bundle[infer]<BR/>manifest python_dependencies</FONT>>];
    weights [shape=cylinder, fillcolor="#fef9c3", color="#eab308", label=<<B>Shared weights store</B><BR/><FONT POINT-SIZE="10">models/store/&lt;source&gt;/&lt;repo&gt;@&lt;rev&gt;-&lt;hash&gt;<BR/>download manifest · resume</FONT>>];
    runtime [fillcolor="#e0f2fe", color="#0284c7", label=<<B>Runtime cache</B><BR/><FONT POINT-SIZE="10">~/.flashcli/runtimes/<BR/>per runtime cell / ABI</FONT>>];
  }

  subgraph cluster_exec {
    label=<<B>Execution / 推理进程</B>>; fontsize=14; color="#fbcfe8"; style="rounded,filled"; fillcolor="#fff7fb";
    py [fillcolor="#fce7f3", color="#db2777", label=<<B>Python infer</B><BR/><FONT POINT-SIZE="10">bundle_venv/bin/python<BR/>-m flashcli_bundle.infer run|serve<BR/>PYTHONPATH=bundle root</FONT>>];
    native [fillcolor="#fce7f3", color="#db2777", label=<<B>Native backend</B><BR/><FONT POINT-SIZE="10">native-exec: process + HTTP/stdio<BR/>native-abi: .so ABI<BR/>no host model logic</FONT>>];
    flashrt [fillcolor="#e0f2fe", color="#0284c7", label=<<B>FlashRT</B><BR/><FONT POINT-SIZE="10">flash_rt · .so · CUDA kernels<BR/>sibling clone / build input<BR/>not pip-installed by host</FONT>>];
  }

  repo -> manifest [label="同步 / 下载", color="#f97316"];
  manifest -> entry [label="解析"];
  manifest -> cells [label="选择环境"];
  manifest -> venv [label="python_dependencies", color="#22c55e"];
  manifest -> weights [label="weights / extra_weights", color="#eab308"];
  cells -> runtime [label="准备 runtime", color="#0284c7"];
  venv -> py [label="python -m infer", color="#db2777"];
  entry -> native [label="native entry", color="#db2777"];
  py -> flashrt [label="import flash_rt", color="#0284c7"];
  native -> flashrt [label=".so / ABI", color="#0284c7"];
  runtime -> py [style=dashed, color="#0284c7"];
  runtime -> native [style=dashed, color="#0284c7"];
  { rank=same; py; native; }
}
