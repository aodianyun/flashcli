digraph bundle_runtime_stack {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.4, ranksep=0.45, fontname="Noto Sans CJK SC", fontsize=30, labelloc=t, label=<<B>Model Bundle 与 FlashRT 运行时栈</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">清单契约 → host 准备 bundle / venv / 权重 → 三种 entry 执行 → bundle 自带 FlashRT</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, margin="0.46,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=11, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  subgraph cluster_1 {
    label=<<B>A. FlashHub 产物与权重源</B>>;
    style="rounded,filled"; color="#F97316"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  repo [shape=cylinder, style="filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=12, width=3.36, label="Bundle 版本\nnamespace/name:version\nflashcli-bundle.json + 各 runtime cell\nweights 只记录来源，不打包"];
  weights_src [shape=cylinder, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=12, width=3.04, label="权重源\nHuggingFace / ModelScope / bundled\nrepo + revision + allow patterns"];
  }
  subgraph cluster_2 {
    label=<<B>B. Manifest 契约（v4）</B>>;
    style="rounded,filled"; color="#EF4444"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  identity [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.3, fontsize=13, width=3.52, label="版本轴\nformat_version 3 / 4\nprotocol_version = 1\nruntime_abi_version = 1（native-abi）\nexec_protocol_version = 1（native-exec）"];
  env [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=3.20, label="defaults + environments\n按 SM / CUDA / Python ABI 选 env key\n精确 key 优先，其次 match 兜底\n选中后合并为有效 manifest"];
  entry [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=3.44, label="entry.run / entry.serve\nkind: python | native-exec | native-abi\nmode: engine | script（仅 python）\ncapabilities + concurrency"];
  resources [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=13, width=3.52, label="resources / system / options\nmin_vram_mib · gpu_count · min_ram_mib\nc/cxx compiler · python headers\nrun_options / serve_options 的默认值"];
  deps [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", penwidth=1.3, fontsize=13, width=3.20, label="python_dependencies\ntorch index + pip 列表\n必须与 runtime cell 的 -py<abi> 一致"];
  weights_meta [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=13, width=3.36, label="weights / extra_weights\nsource · repo · revision\nallow_patterns · require_any_patterns\nrequire_norm_stats · weights_dir\npost_pull / extra_pull"];
  }
  subgraph cluster_3 {
    label=<<B>C. Host 准备（共享 cache 层）</B>>;
    style="rounded,filled"; color="#22C55E"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  ensure_bundle [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=4.16, label="host.EnsureBundle\n本地路径直接使用\nFlashHub：标记或 index → manifest → SyncBundle\n只取选中的 runtime cell\n写 .flashcli_bundle.json + .runtime.json"];
  preflight [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=3.44, label="PreflightBundle\nenv key 必须匹配本机\n识别 .so；host glibc / GLIBCXX / CXXABI"];
  venv [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", penwidth=1.3, fontsize=13, width=2.40, label="venv.Ensure\nruntimes/<runtime_id>/venv\nuv 默认；pip 是退役兜底\nfingerprint 命中即离线复用"];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=13, width=3.60, label="weights.PrepareBundle\nmodels/store/<source>/<repo>@<rev>-<hash>\n主权重 + extra_weights + extra_pull\nhost 完整性：.flashcli_download.json\nbundle 就绪：allow/require + norm stats\npost_pull：paligemma 等"];
  protocol [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=2.96, label="Protocol schema\nCACHE_SCHEMA_VERSION 变化时只升级\nflashcli-bundle，不重装 torch"];
  }
  subgraph cluster_4 {
    label=<<B>D. 执行入口</B>>;
    style="rounded,filled"; color="#38BDF8"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  py_engine [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=4.24, label="python + engine\nimport bundle.entry；实例化 RunEngine/ServeEngine\nload(checkpoint, preset, options)"];
  py_run [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=1.60, label="run → predict()"];
  py_serve [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=2.96, label="serve → warmup() + build_app()\n标准路由由 flashcli-bundle 挂载\nregister_routes() 可覆盖/新增路由"];
  script [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=13, width=3.04, label="python + script\nmain(argv) 自己创建服务器/协议\nhost 不挂路由；manifest env 不生效"];
  native_exec [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=2.64, label="native-exec\n可执行文件 + NDJSON 或 HTTP\nserve(stdio) 未实现；run 可用"];
  native_abi [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=3.28, label="native-abi\ndlopen 生产库 + config JSON\n普通 run 只探测 ABI；session 才能推理"];
  flashrt [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", penwidth=1.3, fontsize=11.5, width=3.84, label="FlashRT\nbundle 的 flash_rt/ 与 runtime/<env>/ 下 .so\nregister_native_modules 先注册，再 import\nhost 只检查 ABI，不安装内核"];
  }
  readiness [shape=note, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=11.5, width=6.24, label="完整性 ≠ 就绪\nhost 只负责文件是否下载完整；bundle 负责 allow/require/norm stats 是否可用\npresent-but-incomplete 永不接受；legacy 无标记且就绪可离线接受"];
  repo -> env [color="#64748B", style="solid", label="解析"];
  repo -> identity [color="#DC2626", style="solid", label="校验"];
  identity -> env [color="#64748B", style="solid"];
  env -> entry [color="#64748B", style="solid"];
  env -> resources [color="#64748B", style="solid"];
  env -> deps [color="#64748B", style="solid"];
  env -> weights_meta [color="#64748B", style="solid"];
  repo -> ensure_bundle [color="#EA580C", style="solid", label="同步"];
  ensure_bundle -> preflight [color="#64748B", style="solid"];
  preflight -> venv [color="#DB2777", style="solid", label="Python cell"];
  preflight -> weights [color="#D97706", style="dashed", label="native cell"];
  venv -> protocol [color="#64748B", style="solid"];
  weights -> protocol [color="#64748B", style="dotted"];
  preflight -> py_engine [color="#7C3AED", style="solid", label="entry.kind"];
  preflight -> native_exec [color="#0284C7", style="solid", label="native-exec"];
  preflight -> native_abi [color="#0284C7", style="solid", label="native-abi"];
  entry -> py_engine [color="#7C3AED", style="dotted", label="engine"];
  entry -> script [color="#EA580C", style="dotted", label="script"];
  py_engine -> py_run [color="#2563EB", style="solid", label="run"];
  py_engine -> py_serve [color="#16A34A", style="solid", label="serve"];
  py_engine -> flashrt [color="#64748B", style="dotted", label="import / dlopen"];
  native_exec -> flashrt [color="#64748B", style="dotted"];
  native_abi -> flashrt [color="#64748B", style="dotted"];
  deps -> venv [color="#DB2777", style="dashed", label="安装"];
  weights_src -> weights_meta [color="#D97706", style="dashed", label="声明"];
  weights_meta -> weights [color="#D97706", style="dashed", label="模式 / 下载 / 就绪"];
  weights -> readiness [color="#64748B", style="dotted"];
}
