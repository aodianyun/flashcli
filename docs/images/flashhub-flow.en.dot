digraph flashhub_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>FlashHub bundle and weights fetch / cache flow</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">publish → repo index → bundle tree → venv / weights → local cache; offline first</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  build [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=13.5, label=<<B>bundles/&lt;name&gt;/build.sh</B><BR/><FONT POINT-SIZE="10.5">compile FlashRT, assemble runtime cells</FONT><BR/><FONT POINT-SIZE="10.5">current host or Docker matrix</FONT>>];
  pack [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>scripts/pack_bundle.sh</B><BR/><FONT POINT-SIZE="10.5">copies only RELEASE_PACK_FILES</FONT><BR/><FONT POINT-SIZE="10.5">select runtime cell; rewrite dist/flashcli-bundle.json</FONT><BR/><FONT POINT-SIZE="10.5">writes build provenance; never packages weights</FONT>>];
  validate [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>flashcli bundle validate</B><BR/><FONT POINT-SIZE="10.5">protocol / entry / capabilities / resources</FONT><BR/><FONT POINT-SIZE="10.5">runtime cell + .so ABI probe</FONT><BR/><FONT POINT-SIZE="10.5">validates the source tree, not dist</FONT>>];
  upload [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=13.5, label=<<B>Manual dist/ upload</B><BR/><FONT POINT-SIZE="10.5">no upload client in this repo</FONT><BR/><FONT POINT-SIZE="10.5">preserve relative paths; the version is the ref</FONT>>];
  repo [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>FlashHub repo index</B><BR/><FONT POINT-SIZE="10.5">GET /api/v1/repos/{ns}/{name}:{ver}</FONT><BR/><FONT POINT-SIZE="10.5">files[] + download_url + md5</FONT>>];
  entry [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>flashcli pull / run / serve</B><BR/><FONT POINT-SIZE="10.5">pull: verifyRemote=true, force remote check</FONT><BR/><FONT POINT-SIZE="10.5">run/serve: local-first, never call host.Pull</FONT>>];
  ensure [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>host.EnsureBundle</B><BR/><FONT POINT-SIZE="10.5">local paths are used directly</FONT><BR/><FONT POINT-SIZE="10.5">FlashHub: marker or index → manifest → SyncBundle</FONT><BR/><FONT POINT-SIZE="10.5">fetch only the selected runtime cell + common files</FONT>>];
  marker [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>bundle marker present?</B><BR/><FONT POINT-SIZE="10.5">bundles/&lt;name&gt;/&lt;ver&gt;/.flashcli_bundle.json</FONT>>];
  reuse [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Reuse bundle tree (offline)</B><BR/><FONT POINT-SIZE="10.5">no file validation, no network</FONT>>];
  sync [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DownloadManifest + SyncBundle</B><BR/><FONT POINT-SIZE="10.5">repo index → manifest</FONT><BR/><FONT POINT-SIZE="10.5">MD5 verify; write runtime / bundle markers</FONT>>];
  runtime [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", fontsize=12.5, label=<<B>host.EnsureRuntime / venv.Ensure</B><BR/><FONT POINT-SIZE="10.5">PreflightBundle: env key / .so / host ABI</FONT><BR/><FONT POINT-SIZE="10.5">uv · flashcli-bundle[infer] · python_dependencies</FONT><BR/><FONT POINT-SIZE="10.5">offline reuse when the fingerprint matches</FONT>>];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>weights.PrepareBundle</B><BR/><FONT POINT-SIZE="10.5">models/store/&lt;source&gt;/&lt;repo&gt;@&lt;rev&gt;-&lt;hash&gt;</FONT><BR/><FONT POINT-SIZE="10.5">host completeness: .flashcli_download.json + .incomplete</FONT><BR/><FONT POINT-SIZE="10.5">bundle readiness: allow / require / norm stats</FONT><BR/><FONT POINT-SIZE="10.5">extra_weights / extra_pull / post_pull</FONT>>];
  cache [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Local cache</B><BR/><FONT POINT-SIZE="10.5">bundles/&lt;name&gt;/&lt;version&gt;</FONT><BR/><FONT POINT-SIZE="10.5">models/store/&lt;source&gt;/&lt;repo&gt;@&lt;rev&gt;-&lt;hash&gt;</FONT><BR/><FONT POINT-SIZE="10.5">runtimes/&lt;runtime_id&gt;/venv</FONT>>];
  offline [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>Offline and readiness</B><BR/><FONT POINT-SIZE="10.5">marker + complete weights + fingerprint → no network</FONT><BR/><FONT POINT-SIZE="10.5">present-but-incomplete is never accepted; a ready legacy cache is</FONT><BR/><FONT POINT-SIZE="10.5">catalog / app registry / desktop use /api/v1, never FlashHub directly</FONT>>];
  build -> pack [color="#EA580C", style="solid"];
  pack -> validate [color="#D97706", style="solid"];
  validate -> upload [color="#DC2626", style="solid", label="pass"];
  upload -> repo [color="#DC2626", style="solid", label="publish version"];
  repo -> entry [color="#EA580C", style="solid", label="index + files"];
  entry -> ensure [color="#64748B", style="solid"];
  ensure -> marker [color="#64748B", style="solid"];
  marker -> reuse [color="#16A34A", style="solid", label="yes"];
  marker -> sync [color="#EA580C", style="solid", label="no"];
  sync -> runtime [color="#EA580C", style="solid"];
  reuse -> runtime [color="#16A34A", style="dashed"];
  runtime -> weights [color="#DB2777", style="solid"];
  weights -> cache [color="#D97706", style="solid"];
  cache -> offline [color="#64748B", style="dotted"];
}
