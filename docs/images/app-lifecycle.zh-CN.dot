digraph app_lifecycle {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>应用安装与配置流程</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">install → prepare → setup → ready；应用只调用 /v1，不拥有模型启停</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  install [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>POST /api/v1/apps/{org}/{name}/install</B><BR/><FONT POINT-SIZE="10.5">body：version · bundles · install_command</FONT><BR/><FONT POINT-SIZE="10.5">client_os / client_arch / force</FONT>>];
  fetch [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>FetchAppManifest + Validate + Platform</B><BR/><FONT POINT-SIZE="10.5">FlashHub app manifest</FONT><BR/><FONT POINT-SIZE="10.5">platform command · default bundles · 版本固定</FONT>>];
  already [shape=diamond, style="filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12, label=<<B>已 prepared / ready 且 force=false？</B>>];
  noop [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=13.5, label=<<B>AlreadyReady（无操作）</B>>];
  planned [shape=box, style="rounded,filled", fillcolor="#E0E7FF", color="#6366F1", fontsize=12.5, label=<<B>planned</B><BR/><FONT POINT-SIZE="10.5">install 命令执行前写入 apps.json</FONT><BR/><FONT POINT-SIZE="10.5">跨进程锁 + 原子写</FONT>>];
  cmd [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>install.command</B><BR/><FONT POINT-SIZE="10.5">run：daemon 执行 shell</FONT><BR/><FONT POINT-SIZE="10.5">client：桌面端本地执行，daemon 只记录</FONT><BR/><FONT POINT-SIZE="10.5">URL：只展示下载页；skip：不执行</FONT>>];
  failed [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=13.5, label=<<B>failed</B><BR/><FONT POINT-SIZE="10.5">install / prepare 失败；日志保留</FONT><BR/><FONT POINT-SIZE="10.5">已缓存 bundle 保留；重试 = 重新 POST install</FONT>>];
  models [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>需要准备默认模型？</B>>];
  preparing [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>preparing</B><BR/><FONT POINT-SIZE="10.5">对 default bundles 串行 host.Pull</FONT><BR/><FONT POINT-SIZE="10.5">全部 Prepared=true</FONT>>];
  prepared [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>prepared</B><BR/><FONT POINT-SIZE="10.5">Connection = {base_url, api_key=local, models, model_refs}</FONT>>];
  setup [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>POST /api/v1/apps/{org}/{name}/setup</B><BR/><FONT POINT-SIZE="10.5">先把 state=ready，再执行 setup scripts</FONT><BR/><FONT POINT-SIZE="10.5">脚本：保存的 plan / SHA-256 校验 / 按序执行</FONT><BR/><FONT POINT-SIZE="10.5">脚本失败只写 setup_error，状态仍是 ready</FONT>>];
  ready [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=13.5, label=<<B>ready</B><BR/><FONT POINT-SIZE="10.5">Connection 在 apps.json；APIKey 固定 local</FONT><BR/><FONT POINT-SIZE="10.5">推理只走 /v1 → gateway → scheduler</FONT>>];
  uninstall [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DELETE /api/v1/apps/{org}/{name}</B><BR/><FONT POINT-SIZE="10.5">默认只删 registry 条目</FONT><BR/><FONT POINT-SIZE="10.5">?purge_models=1 再 RemoveCachedRef</FONT><BR/><FONT POINT-SIZE="10.5">共享资产保留；不自动停 resident</FONT>>];
  uninstalled [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=13.5, label=<<B>uninstalled</B><BR/><FONT POINT-SIZE="10.5">模型缓存 / 日志 / setup-cache 默认保留</FONT>>];
  note [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>桌面端与准备</B><BR/><FONT POINT-SIZE="10.5">client 命令 / 安装器在本地执行，随后 POST install</FONT><BR/><FONT POINT-SIZE="10.5">POST .../prepare：NoInstall + PrepareOnly + Force</FONT><BR/><FONT POINT-SIZE="10.5">应用没有 PID / child endpoint，也不能 start/stop 模型</FONT>>];
  install -> fetch [color="#64748B", style="solid"];
  fetch -> already [color="#64748B", style="solid"];
  already -> noop [color="#64748B", style="solid", label="是"];
  already -> planned [color="#4F46E5", style="solid", label="否"];
  planned -> cmd [color="#64748B", style="solid"];
  cmd -> failed [color="#DC2626", style="dashed", label="失败"];
  cmd -> models [color="#16A34A", style="solid", label="成功"];
  models -> preparing [color="#D97706", style="solid", label="是"];
  models -> prepared [color="#16A34A", style="dashed", label="否"];
  preparing -> prepared [color="#16A34A", style="solid", label="全部完成"];
  preparing -> failed [color="#DC2626", style="dashed", label="失败"];
  prepared -> setup [color="#7C3AED", style="solid", label="配置"];
  setup -> ready [color="#16A34A", style="solid", label="完成 / 脚本失败都 ready"];
  ready -> uninstall [color="#EA580C", style="solid", label="卸载"];
  uninstall -> uninstalled [color="#64748B", style="solid"];
  ready -> setup [color="#7C3AED", style="dashed", label="重新配置"];
  prepared -> note [color="#64748B", style="dotted"];
}
