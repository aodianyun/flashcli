digraph SystemArchitecture {
  graph [rankdir=LR, newrank=true, compound=true, bgcolor="#f7f9fc", pad=0.35,
         nodesep=0.45, ranksep=0.75, fontname="Noto Sans CJK SC", fontsize=24,
         labelloc="t", label=<<B>flashcli 系统架构</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">flashcli · flashserver · FlashHub · Model Bundle · FlashRT</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.16,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  subgraph cluster_clients {
    label=<<B>Clients / 客户端</B>>; fontsize=14; color="#bfdbfe"; style="rounded,filled"; fillcolor="#f8fbff";
    desktop [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Desktop (egui)</B><BR/><FONT POINT-SIZE="10">Windows client<BR/>HTTP + /api/v1/ws</FONT>>];
    browser [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Browser console</B><BR/><FONT POINT-SIZE="10">/ · /docs · /openapi.yaml</FONT>>];
    apps [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Apps / OpenAI SDK</B><BR/><FONT POINT-SIZE="10">/v1 · full bundle ref</FONT>>];
    setup [fillcolor="#e0e7ff", color="#818cf8", label=<<B>flashserver-setup</B><BR/><FONT POINT-SIZE="10">systemd / WSL2 / autostart</FONT>>];
  }

  subgraph cluster_local {
    label=<<B>Local host · WSL / Linux · ~/.flashcli</B>>; fontsize=14; color="#c4b5fd"; style="rounded,filled"; fillcolor="#fbfaff";
    subgraph cluster_server {
      label=<<B>flashserver :8790</B>>; fontsize=13; color="#a78bfa"; style="rounded,filled"; fillcolor="#f5f3ff";
      gw [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>OpenAI 网关</B><BR/><FONT POINT-SIZE="10">/v1 · JSON / SSE / multipart / WS</FONT>>];
      mgmt [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>管理面</B><BR/><FONT POINT-SIZE="10">/api/v1 · jobs · settings · logs</FONT>>];
      sched [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Scheduler</B><BR/><FONT POINT-SIZE="10">placement · lease · queue<BR/>idle stop · eviction</FONT>>];
      mgr [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Manager</B><BR/><FONT POINT-SIZE="10">resident start/stop<BR/>child supervision</FONT>>];
      dev [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Device inventory</B><BR/><FONT POINT-SIZE="10">GPU / CPU / RAM<BR/>runtime cells</FONT>>];
    }
    cli [fillcolor="#dcfce7", color="#22c55e", label=<<B>flashcli (Go host)</B><BR/><FONT POINT-SIZE="10">pull · run · serve · models · app</FONT>>];
    cache [shape=cylinder, fillcolor="#fef9c3", color="#eab308", label=<<B>共享缓存</B><BR/><FONT POINT-SIZE="10">bundles/ · models/store/<BR/>runtimes/ · logs/</FONT>>];
    child [fillcolor="#fce7f3", color="#ec4899", label=<<B>flashcli serve child</B><BR/><FONT POINT-SIZE="10">loopback only<BR/>model process</FONT>>];
  }

  subgraph cluster_remote {
    label=<<B>Remote / build artifacts</B>>; fontsize=14; color="#fed7aa"; style="rounded,filled"; fillcolor="#fffaf5";
    hub [fillcolor="#ffedd5", color="#f97316", label=<<B>FlashHub</B><BR/><FONT POINT-SIZE="10">catalog · apps · bundle repo<BR/>manifest · files · runtime dirs</FONT>>];
    bundle [fillcolor="#fee2e2", color="#ef4444", label=<<B>Model Bundle</B><BR/><FONT POINT-SIZE="10">flashcli-bundle.json<BR/>defaults / environments / resources<BR/>entry: run / serve</FONT>>];
    venv [fillcolor="#fce7f3", color="#db2777", label=<<B>Bundle venv</B><BR/><FONT POINT-SIZE="10">flashcli-bundle[infer]<BR/>python_dependencies</FONT>>];
    rt [fillcolor="#e0f2fe", color="#0284c7", label=<<B>FlashRT</B><BR/><FONT POINT-SIZE="10">flash_rt · .so · CUDA kernels<BR/>sibling clone / build input</FONT>>];
  }

  desktop -> mgmt [label="管理", color="#8b5cf6"];
  desktop -> gw [label="推理", color="#2563eb"];
  browser -> mgmt [label="WS", style=dashed, color="#8b5cf6"];
  apps -> gw [label="/v1", color="#2563eb"];
  setup -> mgmt [label="部署", style=dashed, color="#6366f1"];

  gw -> sched [color="#8b5cf6"];
  mgmt -> sched [color="#8b5cf6"];
  sched -> mgr [color="#8b5cf6"];
  sched -> dev [color="#8b5cf6"];
  mgr -> cli [label="re-exec", color="#0ea5e9"];
  cli -> child [label="spawn", color="#0ea5e9"];
  mgmt -> cache [label="preload / unload", color="#eab308"];
  cli -> cache [color="#eab308"];
  cli -> hub [label="sync / pull", color="#f97316"];
  hub -> bundle [label="publish", color="#f97316"];
  bundle -> venv [label="install deps", color="#db2777"];
  venv -> rt [label="import", color="#0284c7"];
  child -> venv [style=dashed, color="#db2777"];
}
