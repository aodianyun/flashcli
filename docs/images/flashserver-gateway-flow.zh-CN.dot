digraph flashserver_gateway_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>flashserver 网关与模型调度流程</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">/v1 请求 → 路由 / 模型选择 → 磁盘与 capability 门禁 → 调度 → 代理 / 释放</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  client [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>客户端 /v1 请求</B><BR/><FONT POINT-SIZE="10.5">OpenAI / Anthropic SDK / App / Desktop</FONT><BR/><FONT POINT-SIZE="10.5">推理永远不直接访问 child endpoint</FONT>>];
  auth [shape=diamond, style="filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12, label=<<B>token 已配置？</B><BR/><FONT POINT-SIZE="10.5">Bearer / X-Flashcli-Token</FONT><BR/><FONT POINT-SIZE="10.5">失败 → 401</FONT>>];
  route [shape=diamond, style="filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12, label=<<B>路由归属？</B><BR/><FONT POINT-SIZE="10.5">host 标准 / bundle 自定义 / 保留前缀</FONT><BR/><FONT POINT-SIZE="10.5">保留前缀未知路径 → 405/404</FONT>>];
  model [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>选择模型（resolveGatewayModel）</B><BR/><FONT POINT-SIZE="10.5">JSON body / multipart form / ?model=</FONT><BR/><FONT POINT-SIZE="10.5">必须是完整 ref；body 与 query 冲突 → 400</FONT>>];
  assets [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>资产就绪 / preloadReady？</B><BR/><FONT POINT-SIZE="10.5">bundle + weights + runtime</FONT><BR/><FONT POINT-SIZE="10.5">auto_pull=false 且缺失 → 404</FONT>>];
  preload [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>ensurePreload</B><BR/><FONT POINT-SIZE="10.5">启动 host.Pull 后台 job</FONT><BR/><FONT POINT-SIZE="10.5">返回 503 + Retry-After / job id</FONT>>];
  capability [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>capability 已声明？</B><BR/><FONT POINT-SIZE="10.5">仅标准路由；custom 跳过</FONT><BR/><FONT POINT-SIZE="10.5">未声明 → 400 unsupported</FONT>>];
  acquire [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Scheduler.Acquire(ref)</B><BR/><FONT POINT-SIZE="10.5">等待 resident 启动 / 排队</FONT><BR/><FONT POINT-SIZE="10.5">默认 resident_start_wait 10s + queue 30s</FONT>>];
  placement [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>planLocked + placementFor</B><BR/><FONT POINT-SIZE="10.5">max_loaded=0 表示不限制槽位</FONT><BR/><FONT POINT-SIZE="10.5">runtime cell：SM + CUDA + Python ABI</FONT><BR/><FONT POINT-SIZE="10.5">每 GPU 空闲显存 ≥ min_vram + headroom；gpu_count</FONT><BR/><FONT POINT-SIZE="10.5">无 GPU cell → CPU fallback（可禁用）</FONT><BR/><FONT POINT-SIZE="10.5">满槽 / 显存不足 → LRU 淘汰 idle 或排队</FONT>>];
  queue [shape=note, style="filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=10.5, label=<<B>队列 / 无放置</B><BR/><FONT POINT-SIZE="10.5">QueueMax 默认 16；queue_full → 429</FONT><BR/><FONT POINT-SIZE="10.5">no_compatible_runtime 立即失败，不排队</FONT>>];
  start [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>启动 / 复用 resident</B><BR/><FONT POINT-SIZE="10.5">Manager.LoadScheduled → flashcli serve child</FONT><BR/><FONT POINT-SIZE="10.5">WaitHealthy ≤120s；失败 → resident_start_failed</FONT>>];
  lease [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>Lease + Manager.Endpoint(ref)</B><BR/><FONT POINT-SIZE="10.5">active_requests++；阻止淘汰 / idle stop</FONT><BR/><FONT POINT-SIZE="10.5">完整 ref 精确匹配 endpoint</FONT>>];
  proxy [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>proxyGateway</B><BR/><FONT POINT-SIZE="10.5">method / path / query / body 原样转发</FONT><BR/><FONT POINT-SIZE="10.5">剥离 auth / token / cookie；客户端断开 → cancel</FONT><BR/><FONT POINT-SIZE="10.5">SSE 逐条重写；JSON ≤32MiB 重写 model</FONT>>];
  release [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>lease.Release</B><BR/><FONT POINT-SIZE="10.5">leases--；busy → ready；last_used=now</FONT><BR/><FONT POINT-SIZE="10.5">idle reaper / reconcile 死进程</FONT>>];
  errors [shape=note, style="filled", fillcolor="#FEE2E2", color="#EF4444", fontsize=10.5, label=<<B>错误映射</B><BR/><FONT POINT-SIZE="10.5">400 conflict / required / invalid / unsupported</FONT><BR/><FONT POINT-SIZE="10.5">404 not_found / not_servable；405 reserved</FONT><BR/><FONT POINT-SIZE="10.5">429 queue_full；503 preparing / no_placement / starting</FONT><BR/><FONT POINT-SIZE="10.5">499 client_closed；502 proxy / start_failed</FONT>>];
  mgmt [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>控制面不是推理路径</B><BR/><FONT POINT-SIZE="10.5">/api/v1/models/preload：只准备磁盘</FONT><BR/><FONT POINT-SIZE="10.5">/api/v1/models/unload：停止 + 删除缓存</FONT>>];
  client -> auth [color="#64748B", style="solid"];
  auth -> route [color="#16A34A", style="solid", label="是 / 未配置"];
  route -> model [color="#2563EB", style="solid", label="标准 / 自定义"];
  model -> assets [color="#64748B", style="solid"];
  assets -> preload [color="#EA580C", style="solid", label="否 + auto_pull"];
  assets -> capability [color="#16A34A", style="solid", label="是"];
  capability -> acquire [color="#16A34A", style="solid", label="是 / custom"];
  acquire -> placement [color="#64748B", style="solid"];
  placement -> start [color="#16A34A", style="solid", label="有放置"];
  placement -> queue [color="#DC2626", style="dashed", label="资源不足"];
  start -> lease [color="#16A34A", style="solid", label="ready"];
  lease -> proxy [color="#64748B", style="solid"];
  proxy -> release [color="#16A34A", style="solid", label="完成 / 断开"];
  release -> mgmt [color="#64748B", style="dotted"];
  release -> errors [color="#64748B", style="invis"];
}
