digraph flashserver_gateway_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.4, ranksep=0.45, fontname="Noto Sans CJK SC", fontsize=30, labelloc=t, label=<<B>flashserver 网关请求流程</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">认证 → 路由 / 模型选择 → 磁盘与 capability 门禁 → 调度 → 代理 / 释放</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, margin="0.46,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=11, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  subgraph cluster_1 {
    label=<<B>A. 请求与模型选择</B>>;
    style="rounded,filled"; color="#3B82F6"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  client [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.8, fontsize=14, width=3.44, label="客户端\nOpenAI SDK / Anthropic / App / Desktop\n推理只走 /v1，永远拿不到子进程 endpoint"];
  auth [shape=diamond, style="filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.45, fontsize=12, width=2.32, label="token 已配置？\nBearer / X-Flashcli-Token\nWS 可用 ?token="];
  auth_ok [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.12, label="认证通过\n/health / / /docs /openapi /ui 豁免"];
  e401 [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=1.60, label="401 unauthorized"];
  classify [shape=diamond, style="filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.45, fontsize=12, width=3.52, label="路由归属？\nhost 标准 / bundle 自定义 / 保留命名空间"];
  models_ep [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", penwidth=1.3, fontsize=13, width=3.68, label="GET /v1/models · /v1/models/{id}\n本地 registry；不做 model 选择\n带 anthropic-version 时返回 Anthropic 形状"];
  std_sel [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=4.88, label="标准推理路由选择 model\nJSON body：chat/completions/responses/...\nmultipart form：audio/images/videos（videos 也接受 JSON）\nquery：realtime / video jobs / response jobs"];
  custom_sel [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=3.92, label="自定义 /v1/* 选择 model\nJSON 对象 model / multipart form / ?model=\n其他 content-type：?model=，body 原样流式转发"];
  reserved [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=13, width=3.52, label="保留命名空间未知路径\n/v1/models* /v1/responses/* /v1/videos/*"];
  e405 [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=3.44, label="405 method_not_allowed\n或 404 route not found；绝不当作 custom"];
  resolve [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=2.88, label="resolveGatewayModel\nbody / query 都是完整 ref\nbody 与 query 同时存在时必须相同"];
  e400 [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=3.44, label="400 model_conflict / required / invalid\n空值、短名、别名都不接受"];
  ref [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.44, label="ref = namespace/name:version\n缓存 key、调度 key、resident key 都是它"];
  }
  subgraph cluster_2 {
    label=<<B>B. 磁盘与契约门禁（prepareGateway）</B>>;
    style="rounded,filled"; color="#F59E0B"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  assets [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.45, fontsize=12, width=4.16, label="资产就绪或 preloadReady？\nbundle + weights + runtime 都来自共享 host cache"];
  no_pull [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=2.64, label="404 model_not_found\nauto_pull=false，模型未预加载"];
  ensure_preload [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", penwidth=1.3, fontsize=13, width=3.76, label="ensurePreload\nassetsReady → preloaded\n否则启动 host.Pull 后台 job（并发请求共享）"];
  e503prep [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=3.20, label="503 model_preparing\nRetry-After + X-Flashcli-Preload-Job"];
  inspect [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=1.3, fontsize=13, width=2.96, label="inspectRef → inspectBundle\nhost.EnsureBundle + manifest.Load\nResources + ServeCapabilities"];
  e404 [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=2.32, label="404 model_not_found\nbundle 或 manifest 不可读"];
  runonly [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.45, fontsize=12, width=1.60, label="有 serve entry？"];
  e_runonly [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=2.08, label="400 model_not_servable"];
  capability [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.45, fontsize=12, width=2.56, label="标准路由 capability 已声明？\ncustom 路由跳过此门禁"];
  e_cap [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=2.40, label="400 unsupported_capability"];
  sched_ok [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.45, fontsize=12, width=1.76, label="Scheduler 已配置？"];
  e_nosched [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=1.60, label="503 no_placement"];
  }
  subgraph cluster_3 {
    label=<<B>C. 调度与租约（细节见 scheduler 流程图）</B>>;
    style="rounded,filled"; color="#22C55E"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  acquire [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.60, label="Scheduler.Acquire(ref)\n等待 resident 启动 / 排队；默认 10s + 30s\nplacement、LRU、队列见下一张图"];
  lease [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.36, label="Lease（active_requests++）\n阻止 LRU 淘汰、idle stop、force unload"];
  e_queue [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=2.72, label="429 / 503 / 499\nqueue_full / no_placement\nmodel_starting / client_closed"];
  }
  subgraph cluster_4 {
    label=<<B>D. 代理与释放</B>>;
    style="rounded,filled"; color="#38BDF8"; fillcolor="#FFFFFF"; penwidth=1.3; fontcolor="#334155"; fontsize=15; margin=18;
  endpoint [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=3.68, label="Manager.Endpoint(ref)\n完整 ref 精确匹配；不按“唯一 resident”猜"];
  e_endpoint [shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#EF4444", penwidth=1.8, fontsize=14, width=1.76, label="503 model_starting"];
  proxy [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", penwidth=1.3, fontsize=13, width=4.40, label="proxyGateway\nmethod / path / query / body 原样转发\n剥离 host / auth / token / cookie / accept-encoding\n客户端关闭 → cancel 上游请求"];
  rewrite [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fontsize=13, width=3.12, label="响应 model 重写\nSSE：逐条 data: 重写\nJSON ≤32MiB：顶层字符串 model 重写\n其他 / 超大：逐字节透传"];
  release [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", penwidth=1.3, fontsize=13, width=3.36, label="lease.Release\nleases--；busy → ready；last_used=now"];
  idle [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.3, fontsize=13, width=4.24, label="idle reaper（每秒）\nready + leases=0 且超过 idle_stop_seconds → stop"];
  }
  mgmt_note [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", penwidth=1.3, fontsize=11.5, width=7.52, label="控制面不是推理路径\n/api/v1/models/preload 只准备磁盘：inspectRef → checkPreloadVRAM(总显存) → host.Pull job\n/api/v1/models/unload：busy 时 force / wait → stopResident → RemoveCachedRef"];
  client -> auth [color="#64748B", style="solid"];
  auth -> auth_ok [color="#16A34A", style="solid", label="是 / 未配置"];
  auth -> e401 [color="#DC2626", style="dashed", label="否"];
  auth_ok -> classify [color="#64748B", style="solid"];
  classify -> models_ep [color="#64748B", style="solid", label="models"];
  classify -> std_sel [color="#64748B", style="solid", label="host 标准"];
  classify -> custom_sel [color="#0284C7", style="solid", label="自定义"];
  classify -> reserved [color="#EA580C", style="solid", label="保留前缀"];
  reserved -> e405 [color="#DC2626", style="dashed"];
  std_sel -> resolve [color="#64748B", style="solid"];
  custom_sel -> resolve [color="#0284C7", style="solid"];
  resolve -> ref [color="#16A34A", style="solid", label="ok"];
  resolve -> e400 [color="#DC2626", style="dashed", label="失败"];
  ref -> assets [color="#64748B", style="solid"];
  assets -> no_pull [color="#DC2626", style="dashed", label="否 + 禁自动拉取"];
  assets -> ensure_preload [color="#EA580C", style="solid", label="否 + auto_pull"];
  ensure_preload -> e503prep [color="#EA580C", style="dashed", label="job"];
  assets -> inspect [color="#16A34A", style="solid", label="是"];
  ensure_preload -> inspect [color="#16A34A", style="dashed", label="ready"];
  inspect -> e404 [color="#DC2626", style="dashed", label="错误"];
  inspect -> runonly [color="#64748B", style="solid"];
  runonly -> e_runonly [color="#DC2626", style="dashed", label="否"];
  runonly -> capability [color="#16A34A", style="solid", label="是"];
  capability -> e_cap [color="#DC2626", style="dashed", label="否"];
  capability -> sched_ok [color="#16A34A", style="solid", label="是 / custom"];
  sched_ok -> e_nosched [color="#DC2626", style="dashed", label="否"];
  sched_ok -> acquire [color="#16A34A", style="solid", label="是"];
  acquire -> lease [color="#16A34A", style="solid", label="ok"];
  acquire -> e_queue [color="#DC2626", style="dashed", label="失败"];
  lease -> endpoint [color="#64748B", style="solid"];
  endpoint -> e_endpoint [color="#DC2626", style="dashed", label="缺失"];
  endpoint -> proxy [color="#0284C7", style="solid", label="ok"];
  proxy -> rewrite [color="#64748B", style="solid"];
  proxy -> release [color="#16A34A", style="solid", label="完成 / 断开"];
  release -> idle [color="#64748B", style="dotted"];
  idle -> mgmt_note [color="#64748B", style="invis"];
}
