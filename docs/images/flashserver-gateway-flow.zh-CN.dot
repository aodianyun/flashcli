digraph FlashserverGatewayFlow {
  graph [rankdir=TB, bgcolor="#f7f9fc", pad=0.35, nodesep=0.45, ranksep=0.5,
         fontname="Noto Sans CJK SC", fontsize=24, labelloc="t",
         label=<<B>flashserver 网关与调度流程</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">/v1 数据面 · /api/v1 管理面 · 磁盘状态与 resident 状态分离</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.18,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  client [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Client</B><BR/><FONT POINT-SIZE="10">OpenAI SDK / App / Desktop<BR/>完整 bundle ref 作为 model</FONT>>];
  gateway [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>OpenAI Gateway /v1</B><BR/><FONT POINT-SIZE="10">校验 ref · capability<BR/>JSON / SSE / multipart / WS</FONT>>];
  preloaded [shape=diamond, fillcolor="#fef9c3", color="#eab308", label=<<B>磁盘<br/>已准备?</B>>];
  preload [fillcolor="#ffedd5", color="#f97316", label=<<B>Preload job</B><BR/><FONT POINT-SIZE="10">host.Pull<BR/>bundle + runtime + weights</FONT>>];
  preparing [fillcolor="#ffedd5", color="#f97316", label=<<B>503 model_preparing</B><BR/><FONT POINT-SIZE="10">Retry-After<BR/>X-Flashcli-Preload-Job</FONT>>];
  scheduler [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Scheduler</B><BR/><FONT POINT-SIZE="10">placement · min_vram + headroom<BR/>gpu_count · CPU fallback policy<BR/>queue · lease · LRU eviction</FONT>>];
  manager [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Manager</B><BR/><FONT POINT-SIZE="10">start / health / stop<BR/>resident lifecycle</FONT>>];
  child [fillcolor="#fce7f3", color="#ec4899", label=<<B>flashcli serve child</B><BR/><FONT POINT-SIZE="10">loopback only<BR/>never exposed to client</FONT>>];
  proxy [fillcolor="#e0f2fe", color="#0284c7", label=<<B>Lease + proxy</B><BR/><FONT POINT-SIZE="10">JSON / SSE / WS 透传<BR/>model 重写 · token stripping</FONT>>];
  release [fillcolor="#dcfce7", color="#22c55e", label=<<B>Release lease</B><BR/><FONT POINT-SIZE="10">active_requests--<BR/>idle / evict 只看 resident</FONT>>];
  errors [fillcolor="#fee2e2", color="#ef4444", label=<<B>标准错误</B><BR/><FONT POINT-SIZE="10">400 unsupported_capability<BR/>404 model_not_found<BR/>429 queue_full<BR/>503 no_placement / resource_exhausted</FONT>>];
  mgmt [fillcolor="#f5f3ff", color="#a78bfa", label=<<B>Management /api/v1</B><BR/><FONT POINT-SIZE="10">preload / unload（磁盘）<BR/>models · jobs · settings<BR/>devices · scheduler · logs · ws</FONT>>];
  disk [shape=cylinder, fillcolor="#fef9c3", color="#eab308", label=<<B>Disk state</B><BR/><FONT POINT-SIZE="10">absent → preloading<BR/>→ preloaded → unloading</FONT>>];
  resident [shape=note, fillcolor="#f8fafc", color="#cbd5e1", label=<<B>Resident state</B><BR/><FONT POINT-SIZE="10">stopped → starting<BR/>→ ready ⇄ busy<BR/>→ stopping</FONT>>];

  client -> gateway [label="/v1 request", color="#2563eb"];
  gateway -> preloaded [label="检查磁盘"];
  preloaded -> preload [label="否", color="#f97316"];
  preload -> preparing [color="#f97316"];
  preparing -> client [style=dashed, label="重试", color="#f97316"];
  preloaded -> scheduler [label="是", color="#22c55e"];
  gateway -> errors [style=dashed, label="校验失败", color="#ef4444"];
  scheduler -> errors [style=dashed, label="无 placement", color="#ef4444"];
  scheduler -> manager [label="admit / start", color="#8b5cf6"];
  manager -> child [label="spawn + health", color="#ec4899"];
  child -> proxy [label="loopback", color="#0284c7"];
  proxy -> client [label="response / stream", color="#0284c7"];
  proxy -> release [label="完成 / 断开", color="#22c55e"];
  release -> scheduler [label="可 idle stop", style=dashed, color="#22c55e"];
  mgmt -> disk [label="preload / unload", color="#eab308"];
  disk -> preload [style=dotted, color="#eab308"];
  resident -> manager [style=dotted, color="#8b5cf6"];
  mgmt -> resident [style=dotted, color="#8b5cf6"];

  { rank=same; disk; resident; }
}
