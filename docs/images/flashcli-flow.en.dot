digraph flashcli_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>flashcli model inference flow</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">ref → bundle tree → weights / venv / CUDA → inference inside the bundle</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  start [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>flashcli run | serve</B><BR/><FONT POINT-SIZE="10.5">&lt;ref&gt; [OPTIONS] · raw argv</FONT><BR/><FONT POINT-SIZE="10.5">cobra DisableFlagParsing</FONT>>];
  peel [shape=box, style="rounded,filled", fillcolor="#E0E7FF", color="#6366F1", fontsize=12.5, label=<<B>peelHostFlags</B><BR/><FONT POINT-SIZE="10.5">ref · --checkpoint · --mtp-checkpoint</FONT><BR/><FONT POINT-SIZE="10.5">--quiet · --no-auto-install · -h</FONT>>];
  ensure [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>host.EnsureBundle</B><BR/><FONT POINT-SIZE="10.5">force=false; run/serve never call host.Pull</FONT>>];
  source [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>bundle source?</B><BR/><FONT POINT-SIZE="10.5">local path / FlashHub marker / sync</FONT>>];
  sync [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DownloadManifest + SyncBundle</B><BR/><FONT POINT-SIZE="10.5">repo index → manifest</FONT><BR/><FONT POINT-SIZE="10.5">selected runtime cell + common files + markers</FONT>>];
  root [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>bundle tree ready</B><BR/><FONT POINT-SIZE="10.5">local / reuse / sync converge</FONT>>];
  manifest [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>manifest.Load → ApplyEnv → PreflightBundle</B><BR/><FONT POINT-SIZE="10.5">ResolveVariant · EntryFor(capability)</FONT><BR/><FONT POINT-SIZE="10.5">HostEnvKey = SM + CUDA + Python ABI</FONT><BR/><FONT POINT-SIZE="10.5">recognize native .so + host ABI</FONT>>];
  valid [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>manifest / env / entry valid?</B><BR/><FONT POINT-SIZE="10.5">invalid → exit 1/2</FONT>>];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>weights.PrepareBundle</B><BR/><FONT POINT-SIZE="10.5">store key · download manifest · resume</FONT><BR/><FONT POINT-SIZE="10.5">extra_weights · extra_pull · post_pull</FONT><BR/><FONT POINT-SIZE="10.5">allow / require + norm stats readiness</FONT>>];
  venv [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", fontsize=12.5, label=<<B>venv.Ensure + protocol schema</B><BR/><FONT POINT-SIZE="10.5">before venv: EnsureSystemRequirements</FONT><BR/><FONT POINT-SIZE="10.5">uv · flashcli-bundle[infer] · python_dependencies</FONT><BR/><FONT POINT-SIZE="10.5">offline reuse when the fingerprint matches</FONT>>];
  cuda [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>cuda.Ensure</B><BR/><FONT POINT-SIZE="10.5">CUDA SONAME present and dlopen-able</FONT><BR/><FONT POINT-SIZE="10.5">may install nvidia-cublas / cuda-runtime</FONT>>];
  exec [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=13.5, label=<<B>inferexec.Exec</B><BR/><FONT POINT-SIZE="10.5">syscall.Exec replaces the host process</FONT><BR/><FONT POINT-SIZE="10.5">python -m flashcli_bundle.infer &lt;cap&gt; &lt;ref&gt;</FONT>>];
  infer [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>flashcli_bundle.infer</B><BR/><FONT POINT-SIZE="10.5">activate_for_preset</FONT><BR/><FONT POINT-SIZE="10.5">ensure_model_cached(download=False)</FONT>>];
  engine [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>RunEngine / ServeEngine</B><BR/><FONT POINT-SIZE="10.5">run: load → predict() → stdout</FONT><BR/><FONT POINT-SIZE="10.5">serve: load → warmup() → build_app()</FONT><BR/><FONT POINT-SIZE="10.5">register_routes before standard routes</FONT>>];
  note [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>Other entries and boundaries</B><BR/><FONT POINT-SIZE="10.5">script: main(argv) creates its own protocol/server</FONT><BR/><FONT POINT-SIZE="10.5">native-exec: http serve works; stdio serve not implemented</FONT><BR/><FONT POINT-SIZE="10.5">native-abi: plain run probes the ABI; sessions run inference</FONT><BR/><FONT POINT-SIZE="10.5">offline: no network when marker + weights + fingerprint match</FONT>>];
  start -> peel [color="#64748B", style="solid"];
  peel -> ensure [color="#64748B", style="solid"];
  ensure -> source [color="#64748B", style="solid"];
  source -> sync [color="#EA580C", style="solid", label="FlashHub / no marker"];
  source -> root [color="#16A34A", style="dashed", label="local / marker present"];
  sync -> root [color="#EA580C", style="solid"];
  root -> manifest [color="#64748B", style="solid"];
  manifest -> valid [color="#64748B", style="solid"];
  valid -> weights [color="#16A34A", style="solid", label="yes"];
  weights -> venv [color="#D97706", style="solid"];
  venv -> cuda [color="#DB2777", style="solid"];
  cuda -> exec [color="#0284C7", style="solid"];
  exec -> infer [color="#16A34A", style="solid"];
  infer -> engine [color="#7C3AED", style="solid"];
  engine -> note [color="#64748B", style="dotted"];
}
