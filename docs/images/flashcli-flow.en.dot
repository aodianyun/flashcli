digraph FlashcliFlowEN {
  graph [rankdir=TB, bgcolor="#f7f9fc", pad=0.35, nodesep=0.5, ranksep=0.55,
         fontname="Noto Sans CJK SC", fontsize=24, labelloc="t", size="16,9!", ratio=fill,
         label=<<B>flashcli run flow</B><BR/><FONT POINT-SIZE="13" COLOR="#64748b">ref resolution → cache / runtime / weights → run or serve</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=12, margin="0.18,0.10", penwidth=1.2, color="#94a3b8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#64748b", arrowsize=0.75];

  input [fillcolor="#dbeafe", color="#60a5fa", label=<<B>Input</B><BR/><FONT POINT-SIZE="10">flashcli run | serve &lt;ref&gt;<BR/>flashcli-bundle/name:version[@variant]<BR/>or local bundles/&lt;name&gt;</FONT>>];
  parse [fillcolor="#e0e7ff", color="#818cf8", label=<<B>Resolve ref</B><BR/><FONT POINT-SIZE="10">namespace / name / version<BR/>variant · cache key</FONT>>];
  check [shape=diamond, fillcolor="#fef9c3", color="#eab308", label=<<B>Local cache<br/>complete?</B>>];
  sync [fillcolor="#ffedd5", color="#f97316", label=<<B>FlashHub sync</B><BR/><FONT POINT-SIZE="10">repo index<BR/>manifest + bundle files<BR/>runtime dir · weights metadata</FONT>>];
  preflight [fillcolor="#ede9fe", color="#8b5cf6", label=<<B>Preflight</B><BR/><FONT POINT-SIZE="10">GPU / CUDA / Python ABI<BR/>runtime cell match<BR/>system requirements</FONT>>];
  venv [fillcolor="#fce7f3", color="#db2777", label=<<B>Runtime / venv</B><BR/><FONT POINT-SIZE="10">uv / pip<BR/>flashcli-bundle[infer]<BR/>python_dependencies</FONT>>];
  weights [fillcolor="#dcfce7", color="#22c55e", label=<<B>Weights</B><BR/><FONT POINT-SIZE="10">shared models/store/<BR/>download manifest<BR/>post_pull · extra_pull</FONT>>];
  entry [fillcolor="#fef3c7", color="#d97706", label=<<B>Entry point</B><BR/><FONT POINT-SIZE="10">bundle/entry<BR/>Python RunEngine / ServeEngine<BR/>native-exec / native-abi</FONT>>];
  run [fillcolor="#e0f2fe", color="#0284c7", label=<<B>run</B><BR/><FONT POINT-SIZE="10">one-shot inference<BR/>exit after result</FONT>>];
  serve [fillcolor="#e0f2fe", color="#0284c7", label=<<B>serve</B><BR/><FONT POINT-SIZE="10">host-owned HTTP/WS<BR/>OpenAI / Anthropic protocols</FONT>>];
  flashrt [fillcolor="#f1f5f9", color="#64748b", label=<<B>FlashRT</B><BR/><FONT POINT-SIZE="10">flash_rt · .so<BR/>CUDA kernels</FONT>>];
  offline [shape=note, fillcolor="#f8fafc", color="#cbd5e1", label=<<B>Offline guarantee</B><BR/><FONT POINT-SIZE="10">A complete cache that satisfies<BR/>bundle readiness avoids the network;<BR/>only explicit pull / missing assets /<BR/>schema upgrades go online.</FONT>>];

  input -> parse -> check;
  check -> preflight [label="complete (offline)", color="#22c55e"];
  check -> sync [label="missing / explicit pull", color="#f97316"];
  sync -> preflight [label="bundle tree ready", color="#f97316"];
  preflight -> venv [label="runtime ready", color="#8b5cf6"];
  venv -> weights [label="dependencies ready", color="#db2777"];
  weights -> entry [label="checkpoint ready", color="#22c55e"];
  entry -> run [label="run"];
  entry -> serve [label="serve"];
  entry -> flashrt [style=dashed, label="import", color="#64748b"];
  offline -> check [style=dotted, color="#94a3b8", arrowhead=none];
  { rank=same; run; serve; }
}
