digraph flashcli_flow {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad=0.4, nodesep=0.45, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=28, labelloc=t, label=<<B>flashcli 模型推理流程</B><BR/><FONT POINT-SIZE="14" COLOR="#64748B">ref → bundle 树 → 权重 / venv / CUDA → bundle 进程内推理</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12.5, margin="0.30,0.10", penwidth=1.3, color="#94A3B8"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#64748B", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];
  start [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=13.5, label=<<B>flashcli run | serve</B><BR/><FONT POINT-SIZE="10.5">&lt;ref&gt; [OPTIONS] · 原始 argv</FONT><BR/><FONT POINT-SIZE="10.5">cobra DisableFlagParsing</FONT>>];
  peel [shape=box, style="rounded,filled", fillcolor="#E0E7FF", color="#6366F1", fontsize=12.5, label=<<B>peelHostFlags</B><BR/><FONT POINT-SIZE="10.5">ref · --checkpoint · --mtp-checkpoint</FONT><BR/><FONT POINT-SIZE="10.5">--quiet · --no-auto-install · -h</FONT>>];
  ensure [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", fontsize=12.5, label=<<B>host.EnsureBundle</B><BR/><FONT POINT-SIZE="10.5">force=false；run/serve 不调用 host.Pull</FONT>>];
  source [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>bundle 来源？</B><BR/><FONT POINT-SIZE="10.5">本地路径 / FlashHub 标记 / 需要同步</FONT>>];
  sync [shape=box, style="rounded,filled", fillcolor="#FFEDD5", color="#F97316", fontsize=12.5, label=<<B>DownloadManifest + SyncBundle</B><BR/><FONT POINT-SIZE="10.5">repo index → manifest</FONT><BR/><FONT POINT-SIZE="10.5">选中 runtime cell + 公共文件 + 标记</FONT>>];
  root [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>bundle 树就绪</B><BR/><FONT POINT-SIZE="10.5">local / reuse / sync 汇合</FONT>>];
  manifest [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>manifest.Load → ApplyEnv → PreflightBundle</B><BR/><FONT POINT-SIZE="10.5">ResolveVariant · EntryFor(capability)</FONT><BR/><FONT POINT-SIZE="10.5">HostEnvKey = SM + CUDA + Python ABI</FONT><BR/><FONT POINT-SIZE="10.5">识别 native .so + host ABI</FONT>>];
  valid [shape=diamond, style="filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12, label=<<B>manifest / env / entry 有效？</B><BR/><FONT POINT-SIZE="10.5">无效 → exit 1/2</FONT>>];
  weights [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", fontsize=12.5, label=<<B>weights.PrepareBundle</B><BR/><FONT POINT-SIZE="10.5">store key · 下载清单 · 断点续传</FONT><BR/><FONT POINT-SIZE="10.5">extra_weights · extra_pull · post_pull</FONT><BR/><FONT POINT-SIZE="10.5">allow / require + norm stats 就绪</FONT>>];
  venv [shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#F472B6", fontsize=12.5, label=<<B>venv.Ensure + protocol schema</B><BR/><FONT POINT-SIZE="10.5">venv 前：EnsureSystemRequirements</FONT><BR/><FONT POINT-SIZE="10.5">uv · flashcli-bundle[infer] · python_dependencies</FONT><BR/><FONT POINT-SIZE="10.5">fingerprint 命中即离线复用</FONT>>];
  cuda [shape=box, style="rounded,filled", fillcolor="#E0F2FE", color="#38BDF8", fontsize=12.5, label=<<B>cuda.Ensure</B><BR/><FONT POINT-SIZE="10.5">CUDA SONAME 存在且可 dlopen</FONT><BR/><FONT POINT-SIZE="10.5">缺失时可装 nvidia-cublas / cuda-runtime</FONT>>];
  exec [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=13.5, label=<<B>inferexec.Exec</B><BR/><FONT POINT-SIZE="10.5">syscall.Exec 替换 host 进程</FONT><BR/><FONT POINT-SIZE="10.5">python -m flashcli_bundle.infer &lt;cap&gt; &lt;ref&gt;</FONT>>];
  infer [shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#8B5CF6", fontsize=12.5, label=<<B>flashcli_bundle.infer</B><BR/><FONT POINT-SIZE="10.5">activate_for_preset</FONT><BR/><FONT POINT-SIZE="10.5">ensure_model_cached(download=False)</FONT>>];
  engine [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#22C55E", fontsize=12.5, label=<<B>RunEngine / ServeEngine</B><BR/><FONT POINT-SIZE="10.5">run：load → predict() → stdout</FONT><BR/><FONT POINT-SIZE="10.5">serve：load → warmup() → build_app()</FONT><BR/><FONT POINT-SIZE="10.5">register_routes 先于标准路由</FONT>>];
  note [shape=note, style="filled", fillcolor="#F1F5F9", color="#CBD5E1", fontsize=10.5, label=<<B>其他入口与边界</B><BR/><FONT POINT-SIZE="10.5">script：main(argv) 自己创建协议/服务器</FONT><BR/><FONT POINT-SIZE="10.5">native-exec：http serve 可用；stdio serve 未实现</FONT><BR/><FONT POINT-SIZE="10.5">native-abi：普通 run 只探测 ABI；session 才推理</FONT><BR/><FONT POINT-SIZE="10.5">离线：标记 + 权重 + fingerprint 命中则不联网</FONT>>];
  start -> peel [color="#64748B", style="solid"];
  peel -> ensure [color="#64748B", style="solid"];
  ensure -> source [color="#64748B", style="solid"];
  source -> sync [color="#EA580C", style="solid", label="FlashHub / 无标记"];
  source -> root [color="#16A34A", style="dashed", label="local / 标记存在"];
  sync -> root [color="#EA580C", style="solid"];
  root -> manifest [color="#64748B", style="solid"];
  manifest -> valid [color="#64748B", style="solid"];
  valid -> weights [color="#16A34A", style="solid", label="是"];
  weights -> venv [color="#D97706", style="solid"];
  venv -> cuda [color="#DB2777", style="solid"];
  cuda -> exec [color="#0284C7", style="solid"];
  exec -> infer [color="#16A34A", style="solid"];
  infer -> engine [color="#7C3AED", style="solid"];
  engine -> note [color="#64748B", style="dotted"];
}
