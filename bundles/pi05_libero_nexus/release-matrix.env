# Pi0.5 LIBERO + FlashRT-Nexus release matrix — single Python ABI (format_version 3)
# SM120 / cu130 only — Nexus backend is currently SM120-only.
RELEASE_BUNDLE_NAME=pi05_libero_nexus
RELEASE_MATRIX_SM=120
RELEASE_MATRIX_CUDA_TAGS=130
RELEASE_MATRIX_SM120_CUDA_TAGS=130
RELEASE_PYTHON_ABI=310
RELEASE_MATRIX_PY_MINORS=310
RELEASE_ZIP_PREFIX=flashcli-bundle-pi05-nexus
RELEASE_FINALIZE_CUDA_TAG=130
RELEASE_DOCKER_IMAGE_CU130=nvcr.io/nvidia/pytorch:25.10-py3
RELEASE_PACK_FILES="flashcli-bundle.json run.py serve.py _substrate_loader.py _pi05_compat.py _pi05_infer.py flash_rt"
RELEASE_NATIVE_MODULES="flash_rt_kernels flash_rt_fa2"
RELEASE_SUBSTRATE_DIR=runtime/sm120-cu130-linux-x86_64-py310/substrate
