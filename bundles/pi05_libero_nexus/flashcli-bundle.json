{
  "format": "flashcli-model-bundle",
  "format_version": 4,
  "protocol_version": 1,
  "name": "pi05_libero_nexus",
  "description": "native-abi — host dlopen + Nexus embedded session (in-process)",
  "runtime_abi_version": 1,
  "substrate": {
    "kind": "flashrt-nexus",
    "layout": "runtime/<env_key>/substrate/",
    "modules": [
      "libflashrt_exec",
      "libflashrt_cpp_pi05_c",
      "libcapsule_nexus_flashrt"
    ]
  },
  "defaults": {
    "entry": {
      "kind": "native-abi",
      "native": {
        "library": "{runtime_dir}/substrate/libflashrt_cpp_pi05_c-*.so",
        "session_library": "{runtime_dir}/substrate/libcapsule_nexus_flashrt-*.so",
        "preload": [
          "{runtime_dir}/substrate/libflashrt_exec-*.so",
          "{runtime_dir}/substrate/libflashrt_runtime-*.so",
          "{runtime_dir}/substrate/libflashrt_fa2_raw-*.so"
        ],
        "config": {
          "io": "native_v2",
          "checkpoint_path": "{checkpoint}",
          "tokenizer_model_path": "{tokenizer}",
          "state_prompt_mode": "fixed",
          "precision": "fp8_e4m3fn",
          "stage_plan": "{option:stage_plan}",
          "num_views": "{option:num_views}",
          "chunk": 10,
          "state_dim": 8,
          "num_steps": 10,
          "max_prompt_tokens": 64,
          "calibration_path": "{runtime_dir}/calib/pi05_sm120_fp8.calib"
        },
        "inputs": [
          {
            "port": "prompt",
            "kind": "text",
            "option": "prompt"
          },
          {
            "port": "state",
            "kind": "f32",
            "option": "state",
            "dim": 8
          },
          {
            "port": "images",
            "kind": "rgb8",
            "option": "image",
            "views": 2,
            "size": [
              224,
              224
            ]
          }
        ],
        "output": {
          "port": "actions",
          "shape": [
            10,
            7
          ]
        }
      },
      "run": {
        "kind": "native-abi"
      },
      "serve": {
        "kind": "native-abi"
      }
    },
    "run_options": [
      {
        "name": "prompt",
        "type": "string",
        "default": "pick up the red block and place it in the tray",
        "help": "Natural-language task instruction.",
        "phase": "predict"
      },
      {
        "name": "image",
        "type": "string",
        "help": "Comma-separated RGB image paths (one per view).",
        "phase": "predict"
      },
      {
        "name": "state",
        "type": "string",
        "help": "Comma-separated proprio state (defaults to zeros).",
        "phase": "predict"
      },
      {
        "name": "num_views",
        "type": "integer",
        "default": 2,
        "help": "Number of camera views.",
        "phase": "load"
      },
      {
        "name": "stage_plan",
        "type": "string",
        "default": "full",
        "help": "Nexus stage plan: full | context_action.",
        "phase": "load"
      }
    ],
    "serve_options": [
      {
        "name": "host",
        "type": "string",
        "default": "127.0.0.1",
        "help": "HTTP bind host.",
        "phase": "load"
      },
      {
        "name": "port",
        "type": "integer",
        "default": 8080,
        "help": "HTTP bind port.",
        "phase": "load"
      },
      {
        "name": "num_views",
        "type": "integer",
        "default": 2,
        "help": "Number of camera views.",
        "phase": "load"
      },
      {
        "name": "stage_plan",
        "type": "string",
        "default": "full",
        "help": "Nexus stage plan: full | context_action.",
        "phase": "load"
      },
      {
        "name": "warmup_prompt",
        "type": "string",
        "default": "pick up the red block and place it in the tray",
        "help": "Prompt for the optional warmup tick.",
        "phase": "warmup"
      }
    ],
    "weights": {
      "source": "modelscope",
      "repo": "lerobot/pi05_libero_finetuned_v044",
      "revision": "0cdaf1db4e1e0c753ceff023e49f790f6354423f",
      "require_norm_stats": true
    },
    "post_pull": [
      {
        "tokenizer": "paligemma"
      }
    ]
  },
  "environments": {
    "sm120-cu130-linux-x86_64": {
      "runtime": "runtime/sm120-cu130-linux-x86_64"
    }
  }
}
