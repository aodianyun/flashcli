{
  "format": "flashcli-model-bundle",
  "format_version": 4,
  "protocol_version": 1,
  "name": "pi05_libero_nexus",
  "description": "Pi0.5 LIBERO Nexus native-exec alternate manifest (not the published manifest).",
  "exec_protocol_version": 1,
  "substrate": {
    "kind": "flashrt-nexus",
    "layout": "runtime/<env_key>/substrate/",
    "modules": [
      "libflashrt_exec",
      "libflashrt_cpp_pi05_c",
      "libcapsule_nexus_flashrt"
    ]
  },
  "defaults": {
    "entry": {
      "kind": "native-exec",
      "native": {
        "command": [
          "{runtime_dir}/bin/pi05_exec_server",
          "--config",
          "{runtime_dir}/exec_server.json",
          "--checkpoint",
          "{checkpoint}",
          "--runtime-dir",
          "{runtime_dir}",
          "--tokenizer",
          "{tokenizer}",
          "--transport",
          "http",
          "--opt",
          "num_views={option:num_views}",
          "--opt",
          "stage_plan={option:stage_plan}"
        ],
        "transport": "http"
      },
      "run": {
        "kind": "native-exec"
      },
      "serve": {
        "kind": "native-exec"
      }
    },
    "run_options": [
      {
        "name": "prompt",
        "type": "string",
        "default": "pick up the red block and place it in the tray",
        "help": "Natural-language task instruction.",
        "phase": "predict"
      },
      {
        "name": "image",
        "type": "string",
        "help": "Comma-separated RGB image paths (one per view).",
        "phase": "predict"
      },
      {
        "name": "state",
        "type": "string",
        "help": "Comma-separated proprio state (defaults to zeros).",
        "phase": "predict"
      },
      {
        "name": "num_views",
        "type": "integer",
        "default": 2,
        "help": "Number of camera views.",
        "phase": "load"
      },
      {
        "name": "stage_plan",
        "type": "string",
        "default": "full",
        "help": "Nexus stage plan: full | context_action.",
        "phase": "load"
      }
    ],
    "serve_options": [
      {
        "name": "host",
        "type": "string",
        "default": "127.0.0.1",
        "help": "Advertised host (server binds its own port).",
        "phase": "load"
      },
      {
        "name": "port",
        "type": "integer",
        "default": 8080,
        "help": "Advertised port (server binds its own port).",
        "phase": "load"
      },
      {
        "name": "num_views",
        "type": "integer",
        "default": 2,
        "help": "Number of camera views.",
        "phase": "load"
      },
      {
        "name": "stage_plan",
        "type": "string",
        "default": "full",
        "help": "Nexus stage plan: full | context_action.",
        "phase": "load"
      },
      {
        "name": "warmup_prompt",
        "type": "string",
        "default": "pick up the red block and place it in the tray",
        "help": "Prompt for the optional warmup tick.",
        "phase": "warmup"
      }
    ],
    "weights": {
      "source": "modelscope",
      "repo": "lerobot/pi05_libero_finetuned_v044",
      "revision": "0cdaf1db4e1e0c753ceff023e49f790f6354423f",
      "require_norm_stats": true
    },
    "post_pull": [
      {
        "tokenizer": "paligemma"
      }
    ]
  },
  "environments": {
    "sm120-cu130-linux-x86_64": {
      "runtime": "runtime/sm120-cu130-linux-x86_64"
    }
  }
}
