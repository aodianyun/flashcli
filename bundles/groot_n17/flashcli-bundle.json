{
  "format": "flashcli-model-bundle",
  "format_version": 4,
  "protocol_version": 1,
  "name": "groot_n17",
  "description": "GROOT N1.7 VLA \u2014 nvidia/GR00T-N1.7-3B (script: run.py; config=groot_n17, default embodiment oxe_droid_relative_eef_relative_joint)",
  "defaults": {
    "entry": {
      "run": {
        "module": "run",
        "attr": "main",
        "mode": "script"
      }
    },
    "python_abi": "310",
    "python_dependencies": {
      "torch": {
        "package": "torch==2.7.1",
        "index": "auto"
      },
      "pip": [
        "numpy",
        "pyyaml",
        "safetensors",
        "sentencepiece",
        "ml_dtypes",
        "transformers==4.57.3",
        "pillow",
        "torchvision==0.22.1",
        "einops==0.8.1",
        "peft==0.17.1",
        "diffusers==0.35.1",
        "omegaconf==2.3.0",
        "pandas==2.2.3",
        "av==16.1.0",
        "scipy==1.15.3",
        "dm-tree",
        "opencv-python-headless>=4.5,<4.13",
        "albumentations==1.4.18",
        "tyro==0.9.17",
        "tqdm",
        "huggingface-hub[cli]"
      ]
    },
    "extra_weights": {
      "cosmos_backbone": {
        "source": "modelscope",
        "repo": "nv-community/Cosmos-Reason2-2B",
        "revision": "69f09b4b56b25c8ba522052fbaa662e08f969931",
        "checkpoint_subdir": "backbone",
        "allow_patterns": [
          "config.json",
          "generation_config.json",
          "preprocessor_config.json",
          "tokenizer.json",
          "tokenizer_config.json",
          "vocab.json",
          "merges.txt",
          "chat_template.json",
          "video_preprocessor_config.json"
        ]
      }
    },
    "run_options": [
      {
        "name": "prompt",
        "type": "string",
        "default": "put the blue block in the green bowl",
        "help": "Natural-language task instruction for the robot policy.",
        "phase": "predict"
      },
      {
        "name": "image",
        "type": "string",
        "help": "Comma-separated RGB image paths (one per camera view).",
        "phase": "predict"
      },
      {
        "name": "state",
        "type": "string",
        "help": "Optional .npz with state.* arrays for normalization and relative-action decode.",
        "phase": "predict"
      },
      {
        "name": "num_views",
        "type": "integer",
        "default": 2,
        "help": "Number of camera views (oxe_droid_relative_eef_relative_joint uses 2; gr1_unified uses 2; libero_sim uses 2).",
        "phase": "load"
      },
      {
        "name": "embodiment_tag",
        "type": "string",
        "default": "oxe_droid_relative_eef_relative_joint",
        "help": "GROOT N1.7 embodiment slot. See flash_rt/models/groot_n17/embodiments.py for trained tags and view counts.",
        "phase": "load"
      },
      {
        "name": "action_horizon",
        "type": "integer",
        "default": 40,
        "help": "Number of action steps to generate (N1.7 default horizon is 40).",
        "phase": "load"
      },
      {
        "name": "hardware",
        "type": "string",
        "default": "auto",
        "help": "FlashRT backend: auto, rtx_sm89, rtx_sm120, thor.",
        "phase": "load"
      },
      {
        "name": "autotune",
        "type": "integer",
        "default": 3,
        "help": "CUDA graph autotune trials (0 disables).",
        "phase": "load"
      },
      {
        "name": "use_fp8",
        "type": "boolean",
        "default": true,
        "help": "Load policy weights in FP8 when supported.",
        "phase": "load"
      },
      {
        "name": "use_fp16",
        "type": "boolean",
        "default": false,
        "help": "Run full-FP16 baseline (disables FP8).",
        "phase": "load"
      },
      {
        "name": "config",
        "type": "string",
        "default": "groot_n17",
        "help": "FlashRT model config name.",
        "phase": "load"
      }
    ],
    "weights": {
      "source": "huggingface",
      "repo": "nvidia/GR00T-N1.7-3B",
      "revision": "2fc962b973bccdd5d8ce4f67cc63b264d6886495"
    }
  },
  "environments": {
    "sm120-cu130-linux-x86_64-py310": {
      "runtime": "runtime/sm120-cu130-linux-x86_64-py310"
    }
  }
}
