# Pi0.5 LIBERO release matrix — consumed by scripts/build_release_matrix.sh
RELEASE_BUNDLE_NAME=pi05_libero
RELEASE_MATRIX_SM=89
RELEASE_MATRIX_CUDA_TAGS="124 130"
RELEASE_MATRIX_PY_MINORS="310 311 312"
# cu130 cells also build sm120 artifacts (Blackwell); cross-compiled in 25.10-py3 container.
RELEASE_MATRIX_SM120_CUDA_TAGS="130"
RELEASE_ZIP_PREFIX=flashcli-bundle-pi05
RELEASE_FINALIZE_CUDA_TAG=124
RELEASE_DOCKER_IMAGE_CU124=nvcr.io/nvidia/pytorch:24.05-py3
RELEASE_DOCKER_IMAGE_CU130=nvcr.io/nvidia/pytorch:25.10-py3
# Files staged into release zip (space-separated paths relative to bundle dir)
RELEASE_PACK_FILES="flashcli-bundle.json run.py _pi05_compat.py lib flash_rt"
