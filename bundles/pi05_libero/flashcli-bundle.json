    "torch": { "package": "torch", "index": "cu128" },
    "pip": [
      "numpy",
      "pyyaml",
      "safetensors",
      "sentencepiece",
      "ml_dtypes",
      "transformers<4.56",
      "pillow"
    ]
  },
  "weights": {
    "source": "huggingface",
