{
  "format": "flashcli-model-bundle",
  "format_version": 3,
  "name": "pi05_libero",
  "description": "Pi0.5 LIBERO VLA — HuggingFace lerobot/pi05_libero_finetuned_v044",
  "entry": {
    "run": { "module": "run", "attr": "RunEngine" }
  },
  "python_abi": "312",
