{
  "format": "flashcli-model-bundle",
  "format_version": 2,
  "name": "pi05_libero",
  "description": "Pi0.5 LIBERO VLA — HuggingFace lerobot/pi05_libero_finetuned_v044",
  "weights_dir": "checkpoint",
  "capabilities": ["run"],
  "config": "pi05",
  "framework": "torch",
  "weights": {
    "source": "huggingface",
    "repo": "lerobot/pi05_libero_finetuned_v044",
    "revision": "main"
  },
  "post_pull": [{ "tokenizer": "paligemma" }],
  "defaults": {
    "num_views": 2,
    "autotune": 3,
    "hardware": "auto",
    "use_fp8": true
  },
  "requires": {
    "sm": ["89", "120"]
  },
  "entry": {
    "run": {
      "module": "run",
      "attr": "RunEngine"
    }
  },
  "python": ">=3.10,<3.13",
  "python_dependencies": {
    "torch": "torch",
    "pip": [
      "numpy",
      "pyyaml",
      "safetensors",
      "sentencepiece",
      "ml_dtypes",
      "transformers<4.56",
      "pillow"
    ]
  },
  "cuda": {
    "cuda_tag": "128",
    "recommended_torch_index": "cu128"
  },
  "modules": []
}
