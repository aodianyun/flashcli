{
  "format": "flashcli-model-bundle",
  "format_version": 3,
  "protocol_version": 1,
  "name": "qwen_nvfp4",
  "description": "Qwen3-8B + Qwen3.6-27B NVFP4 — per-env runtime cells, @variant selects weights",
  "python_abi": "312",
  "python_dependencies": {
    "torch": { "package": "torch", "index": "auto" },
    "pip": [
      "numpy",
      "pyyaml",
      "safetensors",
      "sentencepiece",
      "ml_dtypes",
      "transformers<4.56",
      "pillow"
    ]
  },
  "runtime": {
    "sm120-cu130-linux-x86_64-py312": "runtime/sm120-cu130-linux-x86_64-py312"
  },
  "entry": {
    "run": { "module": "run", "attr": "RunEngine" },
    "serve": { "module": "serve", "attr": "ServeEngine" }
  },
  "variants": {
    "qwen3": {
      "description": "Qwen3-8B NVFP4 (compressed-tensors) — kaitchup/Qwen3-8B-NVFP4",
      "weights_dir": "checkpoint/qwen3",
      "weights": {
        "source": "huggingface",
        "repo": "kaitchup/Qwen3-8B-NVFP4",
        "revision": "main"
      },
      "run_options": [
        {
          "name": "prompt",
          "type": "string",
          "default": "Hello!",
          "help": "User message for chat completion.",
          "phase": "predict"
        },
        {
          "name": "max_tokens",
          "type": "integer",
          "default": 256,
          "help": "Maximum new tokens to generate.",
          "phase": "predict"
        },
        {
          "name": "temperature",
          "type": "float",
          "default": 0.0,
          "help": "Sampling temperature.",
          "phase": "predict"
        },
        {
          "name": "top_p",
          "type": "float",
          "default": 1.0,
          "help": "Nucleus sampling top-p.",
          "phase": "predict"
        },
        {
          "name": "top_k",
          "type": "integer",
          "default": 0,
          "help": "Top-k sampling (0 disables).",
          "phase": "predict"
        },
        {
          "name": "seed",
          "type": "integer",
          "help": "Random seed (optional).",
          "phase": "predict"
        }
      ],
      "serve_options": [
        {
          "name": "device",
          "type": "string",
          "default": "cuda:0",
          "help": "Torch device for inference.",
          "phase": "load"
        },
        {
          "name": "max_seq",
          "type": "integer",
          "default": 2048,
          "help": "KV / context length budget.",
          "phase": "load"
        },
        {
          "name": "max_q_seq",
          "type": "integer",
          "default": 128,
          "help": "Max prefill chunk size.",
          "phase": "load"
        },
        {
          "name": "model_name",
          "type": "string",
          "default": "qwen3",
          "help": "OpenAI API model id exposed by serve.",
          "phase": "load"
        },
        {
          "name": "warmup_preset",
          "type": "string",
          "default": "auto",
          "help": "Warmup bucket preset: auto|short|all|none.",
          "phase": "warmup"
        },
        {
          "name": "warmup",
          "type": "string",
          "default": "32:128,128:256",
          "help": "Extra CUDA graph warmup shapes (batch:seq,...).",
          "phase": "warmup"
        }
      ]
    },
    "qwen36": {
      "description": "Qwen3.6-27B NVFP4 + MTP — prithivMLmods/Qwen3.6-27B-NVFP4",
      "weights_dir": "checkpoint/qwen36",
      "weights": {
        "source": "huggingface",
        "repo": "prithivMLmods/Qwen3.6-27B-NVFP4",
        "revision": "main"
      },
      "extra_weights": {
        "mtp_fp8": {
          "source": "huggingface",
          "repo": "Qwen/Qwen3.6-27B-FP8",
          "revision": "main",
          "cache_name": "qwen_nvfp4/1.0.1@qwen36/mtp_fp8",
          "allow_patterns": ["mtp.safetensors"]
        }
      },
      "env": {
        "FLASHRT_QWEN36_MTP_CKPT_DIR": "{models_dir}/qwen_nvfp4/1.0.1@qwen36/mtp_fp8"
      },
      "run_options": [                        
        {
          "name": "prompt",
          "type": "string",
          "default": "Hello!",
          "help": "User message for chat completion.",
          "phase": "predict"
        },
        {
          "name": "max_tokens",
          "type": "integer",
          "default": 256,
          "help": "Maximum new tokens to generate.",
          "phase": "predict"
        },
        {
          "name": "temperature",
          "type": "float",
          "default": 0.0,
          "help": "Sampling temperature.",
          "phase": "predict"
        },
        {
          "name": "top_p",
          "type": "float",
          "default": 1.0,
          "help": "Nucleus sampling top-p.",
          "phase": "predict"
        },
        {
          "name": "top_k",
          "type": "integer",
          "default": 0,
          "help": "Top-k sampling (0 disables).",
          "phase": "predict"
        },
        {
          "name": "seed",
          "type": "integer",
          "help": "Random seed (optional).",
          "phase": "predict"
        },
        {
          "name": "K",
          "type": "integer",
          "default": 4,
          "help": "MTP speculative decoding K.",
          "phase": "load"
        }
      ],
      "serve_options": [
        {
          "name": "device",
          "type": "string",
          "default": "cuda:0",
          "help": "Torch device for inference.",
          "phase": "load"
        },
        {
          "name": "max_seq",
          "type": "integer",
          "default": 262208,
          "help": "KV / long-context budget.",
          "phase": "load"
        },
        {
          "name": "K",
          "type": "integer",
          "default": 4,
          "help": "MTP speculative decoding K.",
          "phase": "load"
        },
        {
          "name": "default_max_tokens",
          "type": "integer",
          "default": 2048,
          "help": "Default max_tokens when the client omits it.",
          "phase": "load"
        },
        {
          "name": "max_output_tokens",
          "type": "integer",
          "default": 16384,
          "help": "Hard cap on generated tokens per request.",
          "phase": "load"
        },
        {
          "name": "model_name",
          "type": "string",
          "default": "qwen36",
          "help": "OpenAI API model id exposed by serve.",
          "phase": "load"
        },
        {
          "name": "warmup_preset",
          "type": "string",
          "default": "agent",
          "help": "Warmup bucket preset: agent|short|long|all|none.",
          "phase": "warmup"
        },
        {
          "name": "warmup",
          "type": "string",
          "default": "16:128,128:128",
          "help": "Extra CUDA graph warmup shapes (batch:seq,...).",
          "phase": "warmup"
        },
        {
          "name": "warmup_committed_max_prompt",
          "type": "integer",
          "default": 1024,
          "help": "Committed max prompt length for qwen36 graph warmup.",
          "phase": "warmup"
        }
      ]
    }
  }
}
        