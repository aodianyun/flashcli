{
  "format": "flashcli-model-bundle",
  "format_version": 1,
  "name": "template-model",
  "description": "Copy this tree; implement RunEngine/ServeEngine under partner/ (not in flashcli).",
  "runtime_dir": "runtime",
  "weights_dir": "checkpoint",
  "capabilities": ["run", "serve"],
  "weights": {
    "source": "huggingface",
    "repo": "org/your-model-weights"
  },
  "entry": {
    "run": {
      "module": "partner.run",
      "attr": "RunEngine"
    },
    "serve": {
      "module": "partner.serve",
      "attr": "ServeEngine"
    }
  }
}
