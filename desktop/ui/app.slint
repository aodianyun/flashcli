import { LineEdit, ScrollView } from "std-widgets.slint";

export struct CoreItem {
    label: string,
    value: float,
}

export struct ModelItem {
    name: string,
    status: string,
    size: string,
    loaded: bool,
    ready: bool,
}

export struct LoadedItem {
    name: string,
    endpoint: string,
    meta: string,
}

export struct StorageItem {
    name: string,
    size: string,
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 28px;
    min-width: 56px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? #f1f3f4 : (root.danger ? #ffffff : (root.primary ? #1a73e8 : #ffffff));
    border-width: 1px;
    border-color: !root.enabled ? #e8eaed : (root.danger ? #d93025 : (root.primary ? #1a73e8 : #dadce0));
    opacity: root.enabled ? 1 : 0.55;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        Text {
            text: root.text;
            color: !root.enabled ? #9aa0a6 : (root.danger ? #d93025 : (root.primary ? #ffffff : #3c4043));
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { if (root.enabled) { root.clicked(); } } }
}

component Nav inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: root.active ? #e8f0fe : transparent;
    Text {
        text: root.text;
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 100%;
        color: root.active ? #1a73e8 : #3c4043;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 26px;
    border-radius: 4px;
    background: root.active ? #e8f0fe : transparent;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.active ? #1a73e8 : #3c4043;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked;
    height: 28px;
    border-radius: 4px;
    background: transparent;
    Text {
        text: root.text;
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: 100%;
        color: root.danger ? #d93025 : #3c4043;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Panel inherits Rectangle {
    in property <string> title;
    border-radius: 10px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e8eaed;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;
        Text { text: root.title; color: #5f6368; font-size: 11px; font-weight: 600; }
        @children
    }
}

component Bar inherits Rectangle {
    in property <float> value: 0;
    in property <brush> fill: #1a73e8;
    in property <length> thickness: 5px;
    height: root.thickness;
    border-radius: 3px;
    background: #eef1f4;
    Rectangle {
        width: parent.width * clamp(root.value / 100, 0, 1) < 2px ? 2px : parent.width * clamp(root.value / 100, 0, 1);
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
    }
}

component Stat inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    Text { text: root.k; color: #5f6368; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
    Text { text: root.v; color: #202124; font-size: 12px; font-family: "Consolas"; horizontal-alignment: right; vertical-alignment: center; }
}

component Row inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> last: false;
    height: 36px;
    background: transparent;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.label; color: #5f6368; font-size: 12px; width: 110px; vertical-alignment: center; }
        Text { text: root.value; color: #202124; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
        @children
    }
    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #f1f3f4; visible: !root.last; }
}

component Dialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> message;
    callback cancel;
    callback confirm;
    visible: root.open;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: #20212455;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: 176px;
        border-radius: 10px;
        background: #ffffff;
        border-width: 1px;
        border-color: #dadce0;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: root.title; color: #202124; font-size: 15px; font-weight: 600; }
            Text { text: root.message; color: #5f6368; font-size: 12px; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Btn { text: "取消"; clicked => { root.cancel(); } }
                Btn { text: "确认"; danger: true; clicked => { root.confirm(); } }
            }
        }
    }
    TouchArea { }
}

export component AppWindow inherits Window {
    title: "FlashServer";
    icon: @image-url("icon.png");
    width: 1240px;
    height: 820px;
    background: #f6f7f9;

    in-out property <bool> running: false;
    in-out property <string> status-text: "连接中";
    in-out property <string> version: "";
    in-out property <string> gpu-name: "";
    in-out property <string> gpu-meta: "";
    in-out property <string> gpu-driver: "";
    in-out property <string> gpu-cuda: "";
    in-out property <string> gpu-sm: "";
    in-out property <string> gpu-torch: "";
    in-out property <float> gpu-util: 0;
    in-out property <string> gpu-mem-text: "";
    in-out property <float> gpu-mem: 0;
    in-out property <string> cpu-name: "";
    in-out property <string> cpu-meta: "";
    in-out property <float> cpu-util: 0;
    in-out property <[CoreItem]> cores-left: [];
    in-out property <[CoreItem]> cores-right: [];
    in-out property <string> uptime-text: "";
    in-out property <string> mem-text: "";
    in-out property <float> mem-pct: 0;
    in-out property <string> swap-text: "";
    in-out property <float> swap-pct: 0;
    in-out property <string> service-info: "";
    in-out property <string> autostart: "unknown";
    in-out property <[StorageItem]> storage: [];
    in-out property <[ModelItem]> models: [];
    in-out property <[LoadedItem]> loaded: [];
    in-out property <string> logs: "";
    in-out property <string> load-status: "";
    in-out property <string> load-ref: "";
    in-out property <int> current-tab: 0;
    in-out property <int> menu-open: 0;
    in-out property <image> gpu-chart;
    in-out property <image> cpu-chart;

    in-out property <bool> dialog-open: false;
    in-out property <int> dialog-action: 0;
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <string> dialog-ref: "";

    callback refresh();
    callback start-service();
    callback stop-service();
    callback enable-autostart();
    callback disable-autostart();
    callback do-load(string);
    callback do-unload(string);
    callback open-console();
    callback quit-app();
    callback load-logs();
    callback copy-text(string);

    VerticalLayout {
        spacing: 0;

        // menu bar
        Rectangle {
            height: 30px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e8eaed;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 2px;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    background: #1a73e8;
                    Text { text: "⚡"; color: #ffffff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "FlashServer"; color: #202124; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Rectangle { width: 10px; }
                MenuButton { text: "文件"; active: root.menu-open == 1; clicked => { root.menu-open = root.menu-open == 1 ? 0 : 1; } }
                MenuButton { text: "服务"; active: root.menu-open == 2; clicked => { root.menu-open = root.menu-open == 2 ? 0 : 2; } }
                MenuButton { text: "视图"; active: root.menu-open == 3; clicked => { root.menu-open = root.menu-open == 3 ? 0 : 3; } }
                MenuButton { text: "帮助"; active: root.menu-open == 4; clicked => { root.menu-open = root.menu-open == 4 ? 0 : 4; } }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "刷新"; clicked => { root.refresh(); } }
            }
        }

        HorizontalLayout {
            spacing: 0;

            // sidebar
            Rectangle {
                width: 184px;
                background: #fbfbfc;
                border-width: 1px;
                border-color: #e8eaed;
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Nav { text: "概览"; active: root.current-tab == 0; clicked => { root.current-tab = 0; } }
                    Nav { text: "模型"; active: root.current-tab == 1; clicked => { root.current-tab = 1; } }
                    Nav { text: "已加载"; active: root.current-tab == 2; clicked => { root.current-tab = 2; } }
                    Nav { text: "日志"; active: root.current-tab == 3; clicked => { root.current-tab = 3; root.load-logs(); } }
                    Nav { text: "设置"; active: root.current-tab == 4; clicked => { root.current-tab = 4; } }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: #e8eaed; }
                    VerticalLayout {
                        padding-top: 8px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.running ? #137333 : #d93025; }
                            Text { text: root.status-text; color: root.running ? #137333 : #d93025; font-size: 11px; vertical-alignment: center; }
                        }
                        Text { text: "运行时长 " + root.uptime-text; color: #9aa0a6; font-size: 10px; }
                        Text { text: "本地 · WSL"; color: #9aa0a6; font-size: 10px; }
                        Text { text: "v" + root.version; color: #9aa0a6; font-size: 10px; }
                    }
                }
            }

            // content
            if root.current-tab == 0 : ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 12px;
                        Panel {
                            title: "算力资源";
                            horizontal-stretch: 3;
                            Text { text: root.gpu-name; color: #202124; font-size: 14px; font-weight: 600; }
                            Stat { k: "利用率"; v: Math.round(root.gpu-util) + "%"; }
                            Bar { value: root.gpu-util; fill: #1a73e8; }
                            Stat { k: "全卡显存"; v: root.gpu-mem-text; }
                            Bar { value: root.gpu-mem; fill: #34a853; }
                            Text { text: root.gpu-meta; color: #80868b; font-size: 11px; wrap: word-wrap; }
                            Stat { k: "驱动"; v: root.gpu-driver; }
                            Stat { k: "CUDA"; v: root.gpu-cuda; }
                            Stat { k: "计算能力"; v: root.gpu-sm; }
                            Stat { k: "torch"; v: root.gpu-torch; }
                            Image { source: root.gpu-chart; height: 84px; width: 100%; vertical-stretch: 0; image-fit: fill; }
                        }
                        Panel {
                            title: "处理器";
                            horizontal-stretch: 2;
                            Text { text: root.cpu-name; color: #202124; font-size: 13px; font-weight: 600; }
                            Stat { k: "利用率"; v: Math.round(root.cpu-util) + "%"; }
                            Bar { value: root.cpu-util; fill: #fbbc04; }
                            Text { text: root.cpu-meta; color: #80868b; font-size: 11px; }
                            ScrollView {
                                height: 124px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        for c in root.cores-left : HorizontalLayout {
                                            spacing: 5px;
                                            Text { text: c.label; color: #80868b; font-size: 10px; width: 22px; vertical-alignment: center; }
                                            Bar { value: c.value; fill: #1a73e8; thickness: 4px; horizontal-stretch: 1; }
                                            Text { text: Math.round(c.value) + "%"; color: #80868b; font-size: 10px; width: 26px; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        for c in root.cores-right : HorizontalLayout {
                                            spacing: 5px;
                                            Text { text: c.label; color: #80868b; font-size: 10px; width: 22px; vertical-alignment: center; }
                                            Bar { value: c.value; fill: #1a73e8; thickness: 4px; horizontal-stretch: 1; }
                                            Text { text: Math.round(c.value) + "%"; color: #80868b; font-size: 10px; width: 26px; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            Image { source: root.cpu-chart; height: 46px; width: 100%; vertical-stretch: 0; image-fit: fill; }
                            Stat { k: "内存"; v: root.mem-text; }
                            Bar { value: root.mem-pct; fill: #34a853; }
                            Stat { k: "Swap"; v: root.swap-text; }
                            Bar { value: root.swap-pct; fill: #fbbc04; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Panel {
                            title: "服务状态";
                            horizontal-stretch: 1;
                            Stat { k: "运行时长"; v: root.uptime-text; }
                            Stat { k: "开机启动"; v: root.autostart; }
                            Stat { k: "服务信息"; v: root.service-info; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Btn { text: "启动服务"; primary: true; enabled: !root.running; clicked => { root.start-service(); } }
                                Btn { text: "停止服务"; danger: true; enabled: root.running; clicked => { root.dialog-action = 1; root.dialog-title = "停止服务"; root.dialog-message = "停止后正在加载/运行的模型会中断，已加载模型将不可用。确定停止？"; root.dialog-open = true; } }
                            }
                        }
                        Panel {
                            title: "磁盘占用";
                            horizontal-stretch: 1;
                            for s in root.storage : Stat { k: s.name; v: s.size; }
                        }
                    }
                }
            }

            // models
            if root.current-tab == 1 : VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text: root.load-ref;
                        placeholder-text: "flashcli-bundle/<name>:<version>";
                        edited(t) => { root.load-ref = t; }
                        horizontal-stretch: 1;
                    }
                    Btn { text: "加载模型"; primary: true; clicked => { root.do-load(root.load-ref); } }
                }
                Text { text: root.load-status; color: #1a73e8; font-size: 12px; }
                Rectangle {
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e8eaed;
                    VerticalLayout {
                        Rectangle {
                            height: 30px;
                            background: #fafafa;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 12px;
                                Text { text: "引用"; color: #80868b; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "状态"; color: #80868b; font-size: 11px; width: 56px; vertical-alignment: center; }
                                Text { text: "大小"; color: #80868b; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                Rectangle { width: 62px; }
                            }
                        }
                        ScrollView {
                            VerticalLayout {
                                for m in root.models : Rectangle {
                                height: 36px;
                                background: transparent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { text: m.name; color: #202124; font-size: 12px; font-family: "Consolas"; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    Text { text: m.status; color: m.ready ? #137333 : #d93025; font-size: 11px; width: 56px; vertical-alignment: center; }
                                    Text { text: m.size; color: #80868b; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                    Btn { text: m.loaded ? "已加载" : "加载"; enabled: !m.loaded; primary: !m.loaded; clicked => { root.do-load(m.name); } }
                                }
                                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #f1f3f4; }
                            }
                            }
                        }
                    }
                }
            }

            // loaded
            if root.current-tab == 2 : ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    if root.loaded.length == 0 : Text { text: "还没有加载模型。到「模型」页加载。"; color: #80868b; font-size: 12px; }
                    for l in root.loaded : Rectangle {
                        background: #ffffff;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #e8eaed;
                        height: 54px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text { text: l.name; color: #202124; font-size: 12px; font-family: "Consolas"; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            Text { text: l.endpoint; color: #5f6368; font-size: 11px; vertical-alignment: center; }
                            Btn { text: "复制"; clicked => { root.copy-text(l.endpoint); } }
                            Btn { text: "卸载"; danger: true; clicked => { root.dialog-action = 3; root.dialog-ref = l.name; root.dialog-title = "卸载模型"; root.dialog-message = "卸载后该模型的推理服务会停止，权重和缓存保留。确定卸载？"; root.dialog-open = true; } }
                        }
                    }
                }
            }

            // logs
            if root.current-tab == 3 : VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "服务日志（最近 300 行）"; color: #5f6368; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                    Btn { text: "刷新"; clicked => { root.load-logs(); } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e8eaed;
                    ScrollView {
                        VerticalLayout {
                            padding: 12px;
                            Text { text: root.logs; color: #3c4043; font-size: 11px; font-family: "Consolas"; wrap: word-wrap; }
                        }
                    }
                }
            }

            // settings
            if root.current-tab == 4 : ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Panel {
                        title: "服务";
                        Row { label: "当前状态"; value: root.running ? "运行中" : "已停止"; }
                        Row { label: "开机启动"; value: root.autostart; last: true; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: "启动服务"; primary: true; enabled: !root.running; clicked => { root.start-service(); } }
                            Btn { text: "停止服务"; danger: true; enabled: root.running; clicked => { root.dialog-action = 1; root.dialog-title = "停止服务"; root.dialog-message = "停止后正在加载/运行的模型会中断，已加载模型将不可用。确定停止？"; root.dialog-open = true; } }
                            Btn { text: "启用开机启动"; clicked => { root.enable-autostart(); } }
                            Btn { text: "禁用并停止"; danger: true; clicked => { root.dialog-action = 2; root.dialog-title = "禁用开机启动"; root.dialog-message = "会同时停止当前服务并取消开机启动。确定继续？"; root.dialog-open = true; } }
                            Btn { text: "打开 Web 控制台"; clicked => { root.open-console(); } }
                        }
                    }
                    Panel {
                        title: "关于";
                        Row { label: "客户端"; value: "FlashServer Desktop v" + root.version; }
                        Row { label: "通信"; value: "WebSocket /v1/ws + HTTP /v1/*"; last: true; }
                        HorizontalLayout {
                            alignment: start;
                            Btn { text: "退出客户端"; danger: true; clicked => { root.dialog-action = 4; root.dialog-title = "退出客户端"; root.dialog-message = "退出客户端不会停止 FlashServer 服务。确定退出？"; root.dialog-open = true; } }
                        }
                    }
                }
            }
        }
    }

    if root.menu-open > 0 : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        TouchArea { clicked => { root.menu-open = 0; } }
        Rectangle {
            x: root.menu-open == 1 ? 115px : (root.menu-open == 2 ? 163px : (root.menu-open == 3 ? 211px : 259px));
            y: 30px;
            width: 200px;
            background: #ffffff;
            border-radius: 6px;
            border-width: 1px;
            border-color: #dadce0;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                if root.menu-open == 1 : MenuItem { text: "打开 Web 控制台"; clicked => { root.menu-open = 0; root.open-console(); } }
                if root.menu-open == 1 : MenuItem { text: "退出客户端"; danger: true; clicked => { root.menu-open = 0; root.dialog-action = 4; root.dialog-title = "退出客户端"; root.dialog-message = "退出客户端不会停止 FlashServer 服务。确定退出？"; root.dialog-open = true; } }
                if root.menu-open == 2 : MenuItem { text: "启动服务"; clicked => { root.menu-open = 0; root.start-service(); } }
                if root.menu-open == 2 : MenuItem { text: "停止服务…"; danger: true; clicked => { root.menu-open = 0; root.dialog-action = 1; root.dialog-title = "停止服务"; root.dialog-message = "停止后正在加载/运行的模型会中断，已加载模型将不可用。确定停止？"; root.dialog-open = true; } }
                if root.menu-open == 2 : MenuItem { text: "启用开机启动"; clicked => { root.menu-open = 0; root.enable-autostart(); } }
                if root.menu-open == 2 : MenuItem { text: "禁用并停止…"; danger: true; clicked => { root.menu-open = 0; root.dialog-action = 2; root.dialog-title = "禁用开机启动"; root.dialog-message = "会同时停止当前服务并取消开机启动。确定继续？"; root.dialog-open = true; } }
                if root.menu-open == 3 : MenuItem { text: "概览"; clicked => { root.menu-open = 0; root.current-tab = 0; } }
                if root.menu-open == 3 : MenuItem { text: "模型"; clicked => { root.menu-open = 0; root.current-tab = 1; } }
                if root.menu-open == 3 : MenuItem { text: "已加载"; clicked => { root.menu-open = 0; root.current-tab = 2; } }
                if root.menu-open == 3 : MenuItem { text: "日志"; clicked => { root.menu-open = 0; root.current-tab = 3; root.load-logs(); } }
                if root.menu-open == 3 : MenuItem { text: "设置"; clicked => { root.menu-open = 0; root.current-tab = 4; } }
                if root.menu-open == 4 : MenuItem { text: "刷新数据"; clicked => { root.menu-open = 0; root.refresh(); } }
                if root.menu-open == 4 : MenuItem { text: "打开设置"; clicked => { root.menu-open = 0; root.current-tab = 4; } }
            }
        }
    }

    Dialog {
        open: root.dialog-open;
        title: root.dialog-title;
        message: root.dialog-message;
        cancel => { root.dialog-open = false; }
        confirm => {
            if (root.dialog-action == 1) { root.stop-service(); }
            if (root.dialog-action == 2) { root.disable-autostart(); }
            if (root.dialog-action == 3) { root.do-unload(root.dialog-ref); }
            if (root.dialog-action == 4) { root.quit-app(); }
            root.dialog-open = false;
        }
    }
}
