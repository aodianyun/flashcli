import { LineEdit, ScrollView } from "std-widgets.slint";

export struct CoreItem {
    label: string,
    value: float,
}

export struct ModelItem {
    name: string,
    status: string,
    size: string,
    loaded: bool,
    ready: bool,
}

export struct LoadedItem {
    name: string,
    endpoint: string,
    meta: string,
}

export struct StorageItem {
    name: string,
    size: string,
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    min-width: 72px;
    border-radius: 9px;
    background: !root.enabled ? #171b23 : (root.danger ? #3a1b22 : (root.primary ? #3f7bff : #1d2330));
    border-width: 1px;
    border-color: root.danger ? #6b2c38 : (root.primary ? #3f7bff : #2c3444);
    opacity: root.enabled ? 1.0 : 0.5;
    Text {
        text: root.text;
        color: root.danger ? #ff9aa5 : (root.primary ? white : #e6e9ef);
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 38px;
    width: 96px;
    border-radius: 8px;
    background: root.active ? #1b2230 : transparent;
    Text {
        text: root.text;
        color: root.active ? #e6e9ef : #8b93a3;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    in property <string> title;
    border-radius: 14px;
    background: #171a21;
    border-width: 1px;
    border-color: #272c37;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        Text {
            text: root.title;
            color: #cfd6e4;
            font-size: 14px;
            font-weight: 600;
        }
        @children
    }
}

component Bar inherits Rectangle {
    in property <float> value: 0;
    in property <brush> fill: #4f8cff;
    in property <length> thickness: 8px;
    height: root.thickness;
    border-radius: 4px;
    background: #0d1016;
    border-width: 1px;
    border-color: #222835;
    Rectangle {
        width: parent.width * clamp(root.value / 100, 0, 1) < 3px ? 3px : parent.width * clamp(root.value / 100, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: root.fill;
    }
}

component KV inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    Text { text: root.k; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
    Text { text: root.v; color: #e6e9ef; font-size: 12px; horizontal-alignment: right; }
}

export component AppWindow inherits Window {
    title: "FlashServer";
    icon: @image-url("icon.png");
    width: 1180px;
    height: 820px;
    background: #0f1115;

    in-out property <bool> running: false;
    in-out property <string> status-text: "连接中";
    in-out property <string> version: "";
    in-out property <string> gpu-name: "";
    in-out property <string> gpu-meta: "";
    in-out property <float> gpu-util: 0;
    in-out property <string> gpu-mem-text: "";
    in-out property <float> gpu-mem: 0;
    in-out property <string> cpu-name: "";
    in-out property <string> cpu-meta: "";
    in-out property <float> cpu-util: 0;
    in-out property <[CoreItem]> cores: [];
    in-out property <[CoreItem]> cores-left: [];
    in-out property <[CoreItem]> cores-right: [];
    in-out property <string> load-text: "";
    in-out property <string> uptime-text: "";
    in-out property <string> mem-text: "";
    in-out property <float> mem-pct: 0;
    in-out property <string> swap-text: "";
    in-out property <float> swap-pct: 0;
    in-out property <string> service-info: "";
    in-out property <string> autostart: "unknown";
    in-out property <[StorageItem]> storage: [];
    in-out property <[ModelItem]> models: [];
    in-out property <[LoadedItem]> loaded: [];
    in-out property <string> logs: "";
    in-out property <string> load-status: "";
    in-out property <string> load-ref: "";
    in-out property <int> current-tab: 0;
    in-out property <image> gpu-chart;
    in-out property <image> cpu-chart;

    in-out property <bool> dialog-open: false;
    in-out property <int> dialog-action: 0;
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <string> dialog-ref: "";

    callback refresh();
    callback start-service();
    callback stop-service();
    callback enable-autostart();
    callback disable-autostart();
    callback do-load(string);
    callback do-unload(string);
    callback open-console();
    callback quit-app();
    callback load-logs();
    callback copy-text(string);

    VerticalLayout {
        spacing: 0px;

        // top bar
        Rectangle {
            height: 58px;
            background: #12151c;
            border-width: 1px;
            border-color: #232936;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 14px;
                Text {
                    text: "⚡ FlashServer";
                    color: #e6e9ef;
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: "v" + root.version;
                    color: #8b93a3;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 104px;
                    height: 26px;
                    border-radius: 13px;
                    background: root.running ? #10261f : #261316;
                    border-width: 1px;
                    border-color: root.running ? #1f5c4c : #5c232c;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.running ? #2bd4a7 : #ff5d6c;
                        }
                        Text {
                            text: root.status-text;
                            color: root.running ? #7ef0c8 : #ff9aa5;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
                Btn { text: "刷新"; clicked => { root.refresh(); } }
            }
        }

        // tabs
        Rectangle {
            height: 46px;
            background: #0f1115;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 6px;
                Tab { text: "概览"; active: root.current-tab == 0; clicked => { root.current-tab = 0; } }
                Tab { text: "模型"; active: root.current-tab == 1; clicked => { root.current-tab = 1; } }
                Tab { text: "已加载"; active: root.current-tab == 2; clicked => { root.current-tab = 2; } }
                Tab { text: "日志"; active: root.current-tab == 3; clicked => { root.current-tab = 3; root.load-logs(); } }
                Tab { text: "设置"; active: root.current-tab == 4; clicked => { root.current-tab = 4; } }
            }
        }

        // PAGE: overview
        if root.current-tab == 0 : ScrollView {
            VerticalLayout {
                padding: 18px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        title: "算力资源";
                        horizontal-stretch: 5;
                        vertical-stretch: 0;
                        Text { text: root.gpu-name; color: #e6e9ef; font-size: 14px; font-weight: 600; }
                        HorizontalLayout {
                            Text { text: "利用率"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
                            Text { text: Math.round(root.gpu-util) + "%"; color: #e6e9ef; font-size: 12px; }
                        }
                        Bar { value: root.gpu-util; fill: #4f8cff; }
                        HorizontalLayout {
                            Text { text: "全卡显存"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
                            Text { text: root.gpu-mem-text; color: #e6e9ef; font-size: 12px; }
                        }
                        Bar { value: root.gpu-mem; fill: #2bd4a7; }
                        Text { text: root.gpu-meta; color: #8b93a3; font-size: 12px; wrap: word-wrap; }
                        Image { source: root.gpu-chart; height: 76px; width: 100%; vertical-stretch: 1; image-fit: fill; }
                    }
                    Card {
                        title: "处理器";
                        horizontal-stretch: 4;
                        vertical-stretch: 0;
                        Text { text: root.cpu-name; color: #e6e9ef; font-size: 13px; font-weight: 600; }
                        HorizontalLayout {
                            Text { text: "利用率"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
                            Text { text: Math.round(root.cpu-util) + "%"; color: #e6e9ef; font-size: 12px; }
                        }
                        Bar { value: root.cpu-util; fill: #ffb020; }
                        Text { text: root.cpu-meta; color: #8b93a3; font-size: 12px; }
                        ScrollView {
                            height: 130px;
                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    for c in root.cores-left : HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: c.label; color: #8b93a3; font-size: 10px; width: 26px; vertical-alignment: center; }
                                        Bar { value: c.value; fill: #6f9bff; thickness: 5px; horizontal-stretch: 1; }
                                        Text { text: Math.round(c.value) + "%"; color: #8b93a3; font-size: 10px; width: 30px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    for c in root.cores-right : HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: c.label; color: #8b93a3; font-size: 10px; width: 26px; vertical-alignment: center; }
                                        Bar { value: c.value; fill: #6f9bff; thickness: 5px; horizontal-stretch: 1; }
                                        Text { text: Math.round(c.value) + "%"; color: #8b93a3; font-size: 10px; width: 30px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        Image { source: root.cpu-chart; height: 48px; width: 100%; vertical-stretch: 0; image-fit: fill; }
                        HorizontalLayout {
                            Text { text: "内存"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
                            Text { text: root.mem-text; color: #e6e9ef; font-size: 12px; }
                        }
                        Bar { value: root.mem-pct; fill: #2bd4a7; }
                        HorizontalLayout {
                            Text { text: "Swap"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; }
                            Text { text: root.swap-text; color: #e6e9ef; font-size: 12px; }
                        }
                        Bar { value: root.swap-pct; fill: #ff8f5d; }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        title: "服务状态";
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        KV { k: "运行时长"; v: root.uptime-text; }
                        KV { k: "开机启动"; v: root.autostart; }
                        KV { k: "服务信息"; v: root.service-info; }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { text: "启动服务"; primary: true; enabled: !root.running; clicked => { root.start-service(); } }
                            Btn { text: "停止服务"; enabled: root.running; clicked => { root.dialog-action = 1; root.dialog-title = "停止服务"; root.dialog-message = "停止后正在加载/运行的模型会中断，已加载模型将不可用。确定停止？"; root.dialog-open = true; } }
                        }
                    }
                    Card {
                        title: "磁盘占用";
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        for s in root.storage : KV { k: s.name; v: s.size; }
                    }
                }
            }
        }

        // PAGE: models
        if root.current-tab == 1 : VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                LineEdit {
                    text: root.load-ref;
                    placeholder-text: "flashcli-bundle/<name>:<version>";
                    edited(t) => { root.load-ref = t; }
                    horizontal-stretch: 1;
                }
                Btn { text: "加载模型"; primary: true; clicked => { root.do-load(root.load-ref); } }
            }
            Text { text: root.load-status; color: #8fb4ff; font-size: 12px; }
            ScrollView {
                VerticalLayout {
                    spacing: 6px;
                    for m in root.models : Rectangle {
                        height: 46px;
                        border-radius: 10px;
                        background: #151922;
                        border-width: 1px;
                        border-color: #222835;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 12px;
                            Text { text: m.name; color: #e6e9ef; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            Text { text: m.status; color: m.ready ? #7ef0c8 : #ff9aa5; font-size: 11px; vertical-alignment: center; }
                            Text { text: m.size; color: #8b93a3; font-size: 11px; vertical-alignment: center; }
                            Btn { text: m.loaded ? "已加载" : "加载"; enabled: !m.loaded; clicked => { root.do-load(m.name); } }
                        }
                    }
                }
            }
        }

        // PAGE: loaded
        if root.current-tab == 2 : ScrollView {
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                if root.loaded.length == 0 : Text { text: "还没有加载模型。到「模型」页加载。"; color: #8b93a3; font-size: 13px; }
                for l in root.loaded : Rectangle {
                    height: 64px;
                    border-radius: 12px;
                    background: #151922;
                    border-width: 1px;
                    border-color: #222835;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: l.name; color: #e6e9ef; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                            Btn { text: "复制地址"; clicked => { root.copy-text(l.endpoint); } }
                            Btn { text: "卸载"; danger: true; clicked => { root.dialog-action = 3; root.dialog-ref = l.name; root.dialog-title = "卸载模型"; root.dialog-message = "卸载后该模型的推理服务会停止，权重和缓存保留。确定卸载？"; root.dialog-open = true; } }
                        }
                        Text { text: l.endpoint + "   " + l.meta; color: #8b93a3; font-size: 11px; }
                    }
                }
            }
        }

        // PAGE: logs
        if root.current-tab == 3 : VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: "服务日志（最近 300 行）"; color: #8b93a3; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                Btn { text: "刷新"; clicked => { root.load-logs(); } }
            }
            ScrollView {
                Text {
                    text: root.logs;
                    color: #c4ccda;
                    font-size: 11px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }

        // PAGE: settings
        if root.current-tab == 4 : ScrollView {
            VerticalLayout {
            padding: 18px;
            spacing: 16px;
            Card {
                title: "服务与启动";
                KV { k: "开机启动"; v: root.autostart; }
                Text { text: "关闭开机启动会同时停止服务；再次开启会启动服务。此操作需要管理员权限（UAC）。"; color: #8b93a3; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { text: "启用开机启动"; primary: true; clicked => { root.enable-autostart(); } }
                    Btn { text: "禁用并停止"; danger: true; clicked => { root.dialog-action = 2; root.dialog-title = "禁用开机启动"; root.dialog-message = "会同时停止当前服务并取消开机启动。确定继续？"; root.dialog-open = true; } }
                    Btn { text: "打开 Web 控制台"; clicked => { root.open-console(); } }
                }
            }
            Card {
                title: "关于";
                KV { k: "客户端"; v: "FlashServer Desktop v" + root.version; }
                KV { k: "通信"; v: "WebSocket /v1/ws + HTTP /v1/*"; }
                Text { text: "模型推理与调度由本机 flashserver 完成；客户端只负责监控与控制。"; color: #8b93a3; font-size: 12px; wrap: word-wrap; }
                Btn { text: "退出客户端"; danger: true; clicked => { root.dialog-action = 4; root.dialog-title = "退出客户端"; root.dialog-message = "退出客户端不会停止 FlashServer 服务。确定退出？"; root.dialog-open = true; } }
            }
            }
        }
    }

    Rectangle {
        visible: root.dialog-open;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000b0;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 200px;
            border-radius: 14px;
            background: #1b1f29;
            border-width: 1px;
            border-color: #33405c;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.dialog-title; color: #e6e9ef; font-size: 16px; font-weight: 600; }
                Text { text: root.dialog-message; color: #8b93a3; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Btn { text: "取消"; clicked => { root.dialog-open = false; } }
                    Btn {
                        text: "确认";
                        danger: true;
                        clicked => {
                            if (root.dialog-action == 1) { root.stop-service(); }
                            if (root.dialog-action == 2) { root.disable-autostart(); }
                            if (root.dialog-action == 3) { root.do-unload(root.dialog-ref); }
                            if (root.dialog-action == 4) { root.quit-app(); }
                            root.dialog-open = false;
                        }
                    }
                }
            }
        }
    }
}
